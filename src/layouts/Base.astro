        var gateGo = document.getElementById('arkGateGo');
        var leadNameEl = document.getElementById('arkLeadName');
        var leadPhoneEl = document.getElementById('arkLeadPhone');
        var leadEmailEl = document.getElementById('arkLeadEmail');
        var leadPassEl = document.getElementById('arkLeadPass');
        var gateModes = document.getElementById('arkGateModes');
        var visitorMini = document.getElementById('arkVisitorMini');
        var endBtn = document.getElementById('arkEnd');
        if (!launch || !chat || !msgs || !chipsEl || !form || !input || !gate || !gateForm) return;
        if (launch.dataset.inlineBoot === '1') return;
        launch.dataset.inlineBoot = '1';

        var AV = document.body.getAttribute('data-av') || '/images/logo-icon.webp';
        var WA = document.body.getAttribute('data-wa') || '923159429998';
        var started = false;
        var busy = false;
        var aiHist = [];
        var transcript = [];
        var lead = null;
        var sessionId = '';
        var startNotified = false;
        var transcriptSent = false;
        var gateMode = 'guest';
        var MENU = [
          { label: 'About Abdul', val: 'about' },
          { label: 'Recent work', val: 'work' },
          { label: 'Services', val: 'services' },
          { label: 'Price estimate', val: 'estimate' },
          { label: 'Request a quote', val: 'quote' },
          { label: 'WhatsApp Abdul', val: 'whatsapp', wa: true }
        ];

        function esc(s) {
          return String(s).replace(/[&<>"]/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
          });
        }
        function firstName(n) {
          return String(n || '').trim().split(/\s+/)[0] || 'there';
        }
        function emailOk(v) {
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v || '').trim());
        }
        function phoneOk(v) {
          return String(v || '').replace(/\D/g, '').length >= 7;
        }
        function loadAccount() {
          try {
            var raw = localStorage.getItem('arkVisitorAccount');
            if (!raw) return null;
            var o = JSON.parse(raw);
            if (o && o.name && emailOk(o.email) && phoneOk(o.phone) && o.token) return o;
          } catch (e) {}
          return null;
        }
        function saveAccount(o) {
          try { localStorage.setItem('arkVisitorAccount', JSON.stringify(o)); } catch (e) {}
        }
        function loadLead() {
          var acc = loadAccount();
          if (acc) return { name: acc.name, email: acc.email, phone: acc.phone, token: acc.token };
          try {
            var raw = sessionStorage.getItem('arkChatLead');
            if (!raw) return null;
            var o = JSON.parse(raw);
            if (o && o.name && emailOk(o.email) && phoneOk(o.phone)) return o;
          } catch (e) {}
          return null;
        }
        function saveLead(o) {
          lead = o;
          try { sessionStorage.setItem('arkChatLead', JSON.stringify(o)); } catch (e) {}
        }
        function ensureSession(forceNew) {
          try {
            if (forceNew) {
              sessionId = 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
              sessionStorage.setItem('arkChatSid', sessionId);
              sessionStorage.removeItem('arkChatStartSent');
              return;
            }
            sessionId = sessionStorage.getItem('arkChatSid') || '';
            if (!sessionId) {
              sessionId = 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
              sessionStorage.setItem('arkChatSid', sessionId);
            }
          } catch (e) {
            sessionId = 'c' + Date.now().toString(36);
          }
        }
        function setGateMode(mode) {
          gateMode = mode || 'guest';
          if (gateModes) {
            gateModes.querySelectorAll('button').forEach(function (b) {
              b.classList.toggle('is-on', b.getAttribute('data-mode') === gateMode);
            });
          }
          /* Guest + Sign up: name, email, phone. Sign in: email + password only. */
          var showProfile = gateMode === 'guest' || gateMode === 'signup';
          var showAuth = gateMode === 'signin' || gateMode === 'signup';
          gate.querySelectorAll('.ark-gate-profile').forEach(function (el) { el.hidden = !showProfile; });
          gate.querySelectorAll('.ark-gate-profile-email').forEach(function (el) { el.hidden = false; });
          gate.querySelectorAll('.ark-gate-auth').forEach(function (el) { el.hidden = !showAuth; });
          gate.querySelectorAll('.ark-gate-guest-only').forEach(function (el) { el.hidden = gateMode !== 'guest'; });
          gate.querySelectorAll('.ark-gate-signup-only').forEach(function (el) { el.hidden = gateMode !== 'signup'; });
          if (gateGo) {
            gateGo.textContent = gateMode === 'signin' ? 'Sign in & chat' : (gateMode === 'signup' ? 'Create account & chat' : 'Start chat');
          }
          if (leadPassEl) {
            leadPassEl.required = showAuth;
            leadPassEl.autocomplete = gateMode === 'signup' ? 'new-password' : 'current-password';
          }
          if (leadNameEl) leadNameEl.required = showProfile;
          if (leadPhoneEl) leadPhoneEl.required = showProfile;
          if (leadEmailEl) leadEmailEl.required = true;
        }
        function setGateErr(msg) {
          if (!gateErr) return;
          if (!msg) { gateErr.hidden = true; gateErr.textContent = ''; return; }
          gateErr.hidden = false;
          gateErr.textContent = msg;
        }
        function showVisitor(name) {
          if (!visitorMini) return;
