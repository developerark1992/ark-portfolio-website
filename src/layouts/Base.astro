        }
        function bot(html, chips, delay, title) {
          typing();
          setTimeout(function () { botNow(html, chips, title); }, delay || 420);
        }
        function fmtAI(t) {
          return esc(t).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>').replace(/\n/g, '<br>');
        }
        function scripted(intent) {
          var next = suggestFor(intent);
          if (intent === 'about') {
            return bot('<b>Abdul Rehman Khan</b> is a <b>freelance lead</b> with a <b>mini team of freelancers</b> under the brand <b>ARK Designing Bureau</b> (not a registered company). <b>13+ years since 2013</b>. Websites, apps, design, SEO, marketing, CMS, AWS and AI — plus staff augmentation for agencies.', next.chips, 420, next.title);
          }
          if (intent === 'work') {
            return bot('He has shipped <b>90+ projects</b> across CMS and custom stacks. Open the <b>Projects</b> page to browse live work, or ask for a quote if you have a brief ready.', next.chips, 420, next.title);
          }
          if (intent === 'services') {
            return bot('Abdul covers <b>CMS &amp; e-commerce</b>, <b>Astro/Next.js</b>, <b>.NET</b>, <b>AWS/DevOps</b>, <b>design</b>, <b>SEO/marketing</b>, and <b>AI automation</b>. One lead, freelancers supporting delivery.', next.chips, 420, next.title);
          }
          if (intent === 'estimate') {
            bot('Opening the live cost calculator…', [], 300, 'Quick questions');
            setTimeout(function () { close(); window.location.href = '/estimate'; }, 550);
            return;
          }
          if (intent === 'quote') {
            return bot('Great — the fastest path is a short brief. Tap <b>WhatsApp Abdul</b> to message him directly, or email <b>ark.educationalist@gmail.com</b>. You can also use the contact form on this site.', next.chips, 420, next.title);
          }
          if (intent === 'whatsapp') {
            return bot('Perfect — WhatsApp opens with a ready message. Say hello and share a short brief.', next.chips, 420, next.title);
          }
          return bot('I can help with Abdul’s background, services, pricing, or connect you on WhatsApp. Pick a suggestion or type a question.', MENU, 420, 'Quick questions');
        }
        function askAI(text) {
          busy = true;
          aiHist.push({ role: 'user', text: text });
          typing();
          fetch('/api/chat', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ message: text, history: aiHist })
          })
            .then(function (r) { return r.json(); })
            .then(function (d) {
              busy = false;
              var next = suggestFor(null, text);
              if (d && d.ok && d.reply) {
                aiHist.push({ role: 'model', text: d.reply });
                botNow(fmtAI(d.reply), next.chips, next.title);
              } else {
                untype();
                scripted('menu');
              }
            })
            .catch(function () {
              busy = false;
              untype();
              scripted('menu');
            });
        }
        function handleUser(val, label) {
          if (!lead) return;
          var shown = label || val;
          me(shown);
          var key = String(val || '').toLowerCase();
          if (val === 'about' || val === 'work' || val === 'services' || val === 'estimate' || val === 'quote' || val === 'whatsapp') {
            return scripted(val);
          }
          if (/about/.test(key)) return scripted('about');
          if (/work|project/.test(key)) return scripted('work');
          if (/service/.test(key)) return scripted('services');
          if (/estimate|price|pricing|cost/.test(key)) return scripted('estimate');
          if (/quote|hire|enquiry|inquiry/.test(key)) return scripted('quote');
          if (/whatsapp|wa\b/.test(key)) return scripted('whatsapp');
          askAI(shown);
        }

        function beginChat(opts) {
          opts = opts || {};
          setChatReady(true);
          showVisitor(lead.name);
          if (!opts.skipNotify) notifyStart(!!opts.returning);
          if (!started) {
            started = true;
            var hi = firstName(lead.name);
            var welcome = opts.returning
              ? 'Welcome back, <b>' + esc(hi) + '</b> — good to see you again. What would you like to know today?'
              : 'Hi <b>' + esc(hi) + '</b> — I’m Abdul’s assistant. Ask about his experience, get a quick price estimate, or leave a project enquiry. What would you like to know?';
            bot(welcome, MENU, 220, 'Quick questions');
          }
          setTimeout(function () { try { input.focus(); } catch (e) {} }, 250);
        }

        function open() {
          chat.hidden = false;
          launch.hidden = true;
          ensureSession(false);
          setGateMode(gateMode || 'guest');
          lead = loadLead();
          if (lead && lead.token) {
            if (leadNameEl) leadNameEl.value = lead.name;
            if (leadPhoneEl) leadPhoneEl.value = lead.phone;
            if (leadEmailEl) leadEmailEl.value = lead.email;
            saveLead(lead);
            if (gateGo) { gateGo.disabled = true; gateGo.textContent = 'Signing in…'; }
            fetch('/api/visitor-auth', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ action: 'session', token: lead.token, page: location.href, sessionId: sessionId })
            }).then(function (r) { return r.json(); }).then(function (d) {
              if (gateGo) { gateGo.disabled = false; gateGo.textContent = 'Start chat'; }
              if (d && d.ok && d.visitor) {
                saveAccount(d.visitor);
                saveLead({ name: d.visitor.name, email: d.visitor.email, phone: d.visitor.phone, token: d.visitor.token });
                beginChat({ returning: true, skipNotify: true });
              } else {
                try { localStorage.removeItem('arkVisitorAccount'); } catch (e) {}
                setChatReady(false);
                setGateMode('signin');
                setTimeout(function () { try { if (leadEmailEl) leadEmailEl.focus(); } catch (e) {} }, 200);
              }
            }).catch(function () {
              if (gateGo) { gateGo.disabled = false; }
              beginChat({ returning: !!lead.token, skipNotify: false });
            });
            return;
          }
          if (lead) {
            if (leadNameEl) leadNameEl.value = lead.name;
            if (leadPhoneEl) leadPhoneEl.value = lead.phone;
            if (leadEmailEl) leadEmailEl.value = lead.email;
            beginChat({ returning: false });
          } else {
            setChatReady(false);
            showVisitor('');
            setTimeout(function () { try { if (leadNameEl) leadNameEl.focus(); } catch (e) {} }, 200);
          }
        }
        function close() {
          flushTranscript(false);
          chat.hidden = true;
          launch.hidden = false;
        }
        function endSession() {
          if (!lead) { close(); return; }
          if (endBtn) { endBtn.disabled = true; endBtn.textContent = 'Ending…'; }
          flushTranscript(true).finally(function () {
            resetConversation();
            setChatReady(false);
            showVisitor('');
            chat.hidden = true;
            launch.hidden = false;
            if (endBtn) { endBtn.disabled = false; endBtn.textContent = 'End'; }
            /* Keep saved account so they can skip the form next time */
            lead = loadLead();
          });
        }

        window.arkOpenChat = open;
        window.arkCloseChat = close;

        if (gateModes) {
          gateModes.addEventListener('click', function (e) {
            var b = e.target.closest('button[data-mode]');
            if (b) setGateMode(b.getAttribute('data-mode'));
          });
        }
        setGateMode('guest');

        gateForm.addEventListener('submit', function (e) {
          e.preventDefault();
          var name = (leadNameEl && leadNameEl.value || '').trim();
          var phone = (leadPhoneEl && leadPhoneEl.value || '').trim();
          var email = (leadEmailEl && leadEmailEl.value || '').trim();
          var password = (leadPassEl && leadPassEl.value || '');
          setGateErr('');

          if (gateMode === 'signin') {
            if (!emailOk(email)) { setGateErr('Enter your email.'); return; }
            if (password.length < 6) { setGateErr('Enter your password.'); return; }
            if (gateGo) { gateGo.disabled = true; gateGo.textContent = 'Signing in…'; }
            ensureSession(false);
            fetch('/api/visitor-auth', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ action: 'login', email: email, password: password, page: location.href, sessionId: sessionId })
            }).then(function (r) { return r.json(); }).then(function (d) {
              if (gateGo) { gateGo.disabled = false; gateGo.textContent = 'Sign in & chat'; }
              if (!d || !d.ok) {
                setGateErr(d && d.error === 'bad-credentials' ? 'Wrong email or password.' : 'Sign-in failed. Try again or use Guest.');
                return;
              }
              saveAccount(d.visitor);
              saveLead({ name: d.visitor.name, email: d.visitor.email, phone: d.visitor.phone, token: d.visitor.token });
              startNotified = true;
              try { sessionStorage.setItem('arkChatStartSent', sessionId); } catch (err) {}
              beginChat({ returning: true, skipNotify: true });
            }).catch(function () {
              if (gateGo) { gateGo.disabled = false; gateGo.textContent = 'Sign in & chat'; }
              setGateErr('Network error — try again.');
            });
            return;
          }

          if (gateMode === 'signup') {
            if (!name) { setGateErr('Please enter your name.'); return; }
            if (!phoneOk(phone)) { setGateErr('Please enter a valid phone number.'); return; }
            if (!emailOk(email)) { setGateErr('Please enter a valid email.'); return; }
            if (password.length < 6) { setGateErr('Password must be at least 6 characters.'); return; }
            if (gateGo) { gateGo.disabled = true; gateGo.textContent = 'Creating…'; }
            ensureSession(false);
            fetch('/api/visitor-auth', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ action: 'signup', name: name, email: email, phone: phone, password: password, page: location.href, sessionId: sessionId })
            }).then(function (r) { return r.json(); }).then(function (d) {
              if (gateGo) { gateGo.disabled = false; gateGo.textContent = 'Create account & chat'; }
              if (!d || !d.ok) {
                setGateErr(d && d.error === 'exists' ? 'Account already exists — use Sign in.' : 'Signup failed. You can still use Guest.');
                return;
              }
              saveAccount(d.visitor);
              saveLead({ name: d.visitor.name, email: d.visitor.email, phone: d.visitor.phone, token: d.visitor.token });
              startNotified = true;
              try { sessionStorage.setItem('arkChatStartSent', sessionId); } catch (err) {}
              beginChat({ returning: false, skipNotify: true });
            }).catch(function () {
              if (gateGo) { gateGo.disabled = false; gateGo.textContent = 'Create account & chat'; }
              setGateErr('Network error — try again.');
            });
            return;
          }

          /* Guest — capture lead instantly then start */
          if (!name) { setGateErr('Please enter your name.'); if (leadNameEl) leadNameEl.focus(); return; }
          if (!phoneOk(phone)) { setGateErr('Please enter a valid phone number.'); if (leadPhoneEl) leadPhoneEl.focus(); return; }
          if (!emailOk(email)) { setGateErr('Please enter a valid email address.'); if (leadEmailEl) leadEmailEl.focus(); return; }
          if (gateGo) { gateGo.disabled = true; gateGo.textContent = 'Saving lead…'; }
          ensureSession(false);
          saveLead({ name: name, phone: phone, email: email });
          startNotified = false;
          try { sessionStorage.removeItem('arkChatStartSent'); } catch (err) {}
          notifyStart(false).then(function (d) {
            if (gateGo) { gateGo.disabled = false; gateGo.textContent = 'Start chat'; }
            if (d && d.ok === false && d.error && d.error !== 'mail-not-configured') {
              setGateErr('Could not save lead — check connection and try again.');
            }
            beginChat({ returning: false, skipNotify: true });
          }).catch(function () {
            if (gateGo) { gateGo.disabled = false; gateGo.textContent = 'Start chat'; }
            beginChat({ returning: false, skipNotify: true });
          });
        });

        if (suggestToggle) {
          try {
            if (sessionStorage.getItem('arkSuggestMin') === '1') applySuggestMin(true);
          } catch (e) {}
          suggestToggle.addEventListener('click', function () {
            applySuggestMin(!(suggestEl && suggestEl.classList.contains('is-min')));
          });
        }

        launch.addEventListener('click', function () {
          if (typeof window.arkOpenChat === 'function') window.arkOpenChat();
          else open();
        });
        if (closeBtn) closeBtn.addEventListener('click', close);
        if (endBtn) endBtn.addEventListener('click', endSession);
        var waBtn = document.getElementById('arkWa');
        if (waBtn) {
          waBtn.addEventListener('click', function () {
            if (chat.hidden) open();
            if (!lead) return;
            handleUser('whatsapp', 'WhatsApp Abdul');
          });
        }
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (busy || !lead) return;
          var t = input.value.trim();
          if (!t) return;
          input.value = '';
          handleUser(t, t);
        });
        if (!window.__arkEsc) {
          window.__arkEsc = true;
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && chat && !chat.hidden) close();
          });
        }
        if (!window.__arkChatFlush) {
          window.__arkChatFlush = true;
          window.addEventListener('pagehide', function () { flushTranscript(false); });
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'hidden') flushTranscript(false);
          });
        }
      }

      function bootTracker() {
        try {
          if (location.pathname.indexOf('/dashboard') === 0) return;
          var vid = localStorage.getItem('arkVid');
          if (!vid) {
            vid = 'v' + Date.now().toString(36) + Math.random().toString(36).slice(2, 10);
            localStorage.setItem('arkVid', vid);
          }
          var sid = sessionStorage.getItem('arkChatSid') || sessionStorage.getItem('arkVidSid');
          if (!sid) {
            sid = 's' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
            sessionStorage.setItem('arkVidSid', sid);
          }
          var payload = JSON.stringify({
            visitorId: vid,
            sessionId: sid,
            path: location.pathname + location.search,
            referrer: document.referrer || '',
            title: document.title || ''
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
          } else {
            fetch('/api/track', { method: 'POST', headers: { 'content-type': 'application/json' }, body: payload, keepalive: true }).catch(function () {});
          }
        } catch (e) {}
      }

      function bootCritical() {
        bootMenu();
        bootChat();
        bootTracker();
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootCritical);
      else bootCritical();

      /* Always load site.js for calculator / lightbox — chat already works inline. */
      var s = document.createElement('script');
      s.src = '/js/site.js?v=20261001i';
      s.defer = true;
      document.body.appendChild(s);
    })();
  </script>
</body>
</html>
