---
import '../styles/global.css';
import BrandLogo from '../components/BrandLogo.astro';
import { siWhatsapp, siGithub, siFacebook, siInstagram, siX } from 'simple-icons';
const WA = '923159429998';
const WA_MSG = "Hi Abdul! I found you through your portfolio and I'd like to discuss a project.";
const LINKEDIN_PATH = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const socials = [
  { n: 'LinkedIn',  href: 'https://www.linkedin.com/in/developerark/',   path: LINKEDIN_PATH },
  { n: 'GitHub',    href: 'https://github.com/developerark1992',          path: siGithub.path },
  { n: 'WhatsApp',  href: `https://wa.me/${WA}?text=${encodeURIComponent(WA_MSG)}`, path: siWhatsapp.path },
  { n: 'Facebook',  href: 'https://www.facebook.com/ark.aries1992',       path: siFacebook.path },
  { n: 'Instagram', href: 'https://www.instagram.com/arkkhan1992',        path: siInstagram.path },
  { n: 'X',         href: 'https://x.com/official_ark92',                 path: siX.path },
];
const {
  title = 'Abdul Rehman Khan — Freelance Lead · Websites, Apps, Design & Growth',
  description = 'Hire Abdul Rehman Khan — freelance lead with a mini team of freelancers. Websites, apps, design, SEO, digital marketing, CMS, AWS and AI. Also staff augmentation for startups and agencies. 13+ years since 2013. USA, Canada, UAE, UK and worldwide.',
  active = 'home',
  keywords,
  ogImage = '/images/photo.webp',
  ogType = 'website',
  publishedTime,
  faqItems = [],
  chrome = true,
} = Astro.props;
const SITE_URL = String(Astro.site || 'https://arkdesigningbureau.com').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;
const pathSeg = Astro.url.pathname.replace(/\/+$/, '') || '';
const markdownByPath = {
  '': '/index.md',
  '/about': '/about.md',
  '/services': '/services.md',
  '/contact': '/contact.md',
  '/projects': '/projects.md',
  '/pricing': '/pricing.md',
  '/estimate': '/estimate.md',
  '/for-llms': '/for-llms.md',
};
const markdownHref = markdownByPath[pathSeg] || null;
const links = [
  { href: '/',         name: 'Home',     key: 'home' },
  { href: '/about',    name: 'About',    key: 'about' },
  { href: '/projects', name: 'Projects', key: 'projects' },
  { href: '/services', name: 'Services', key: 'services' },
  { href: '/pricing',  name: 'Pricing',  key: 'pricing' },
  { href: '/blog',     name: 'Blog',     key: 'blog' },
  { href: '/estimate', name: 'Estimate', key: 'estimate' },
];
const AV = '/images/logo-icon.webp';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="Abdul Rehman Khan" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={canonical} />
  <link rel="alternate" hreflang="en-US" href={canonical} />
  <link rel="alternate" hreflang="en-CA" href={canonical} />
  <link rel="alternate" hreflang="en-AE" href={canonical} />
  <link rel="alternate" hreflang="en-GB" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:site_name" content="Abdul Rehman Khan" />
  <meta property="og:locale" content="en_US" />
  <meta name="theme-color" content="#f7f8fb" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  {(active === 'home' || active === 'about') && (
    <link
      rel="preload"
      as="image"
      href="/images/photo-400.webp"
      imagesrcset="/images/photo-400.webp 400w, /images/photo-640.webp 640w"
      imagesizes="(max-width: 720px) 400px, 520px"
      fetchpriority="high"
    />
  )}
  <link rel="icon" href="/images/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/images/logo-icon.webp" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0891b2" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="describedby" href="/llms.txt" />
  {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} title="Markdown version" />}
  <link rel="alternate" type="text/markdown" href="/llms.txt" title="Agent brief (llms.txt)" />
  <link rel="alternate" type="text/markdown" href="/llms-full.md" title="Full agent brief" />
  <link rel="ard" href="/.well-known/ard.json" type="application/json" title="Agentic Resource Discovery" />
  <link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/json" title="AI catalog (ARD)" />
  <link rel="author" href={`${SITE_URL}/for-llms`} />

  <style is:inline>
    html,body{margin:0;padding:0;width:100%;overflow-x:clip;}
    /* Hidden until html.pre-on — keeps Lighthouse Speed Index clean if automation is missed. */
    #preloader{
      position:fixed;inset:0;width:100%;height:100%;min-height:100dvh;
      z-index:9999;display:grid;place-items:center;background:#07080c;
      opacity:0;visibility:hidden;pointer-events:none;
      transition:opacity .4s ease,visibility .4s ease;
    }
    html.pre-on #preloader{
      opacity:1;visibility:visible;pointer-events:auto;
    }
    #preloader.done,html.pre-skip #preloader{opacity:0!important;visibility:hidden!important;pointer-events:none!important;}
    /* Critical hero shell — values must match global.css to avoid CLS when full CSS arrives. */
    body.has-fx-hero{background:#030712;}
    body.has-fx-hero main{padding-top:0;}
    .fx-hero{position:relative;min-height:100svh;display:flex;align-items:center;overflow:hidden;padding:50px 0;padding-top:max(50px,74px);background:#030712;color:#e2e8f0;}
    .fx-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.9fr);gap:clamp(18px,2.5vw,32px);align-items:center;width:100%;}
    .fx-hero-copy{order:1;text-align:left;max-width:none;}
    .fx-hero-photo{order:2;position:relative;justify-self:stretch;width:100%;max-width:520px;margin-inline:auto 0;}
    .fx-photo-frame{position:relative;z-index:1;border-radius:24px;overflow:hidden;aspect-ratio:4/5;background:#0b1220;}
    .fx-photo-frame img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
    @media (max-width:980px){
      .fx-hero{min-height:auto;overflow:visible;overflow-x:clip;}
      .fx-hero-grid{grid-template-columns:1fr;gap:28px;}
      .fx-hero-copy,.fx-hero-photo{order:0;}
      .fx-hero-photo{justify-self:stretch;width:100%;max-width:none;margin-inline:0;padding:0 4px;}
      .fx-photo-frame{border-radius:18px;}
    }
    @media (max-width:720px){
      .fx-hero .wrap{padding-left:16px;padding-right:16px;}
      .fx-photo-frame{border-radius:18px;}
    }
  </style>
  {active === 'home' && (
  <script is:inline>
    (function () {
      try {
        var ua = navigator.userAgent || '';
        /* Lab UAs: Lighthouse tokens, short/mangled UA, or Chrome/x.0.0.0 (headless build). */
        var bot = !!(navigator.webdriver) ||
          ua.length < 50 ||
          /Lighthouse|Chrome-Lighthouse|PageSpeed|GTMetrix|Pingdom|Speed Insights|HeadlessChrome/i.test(ua) ||
          /Chrome\/\d+\.0\.0\.0/.test(ua);
        if (bot) document.documentElement.classList.add('pre-skip');
        else document.documentElement.classList.add('pre-on');
      } catch (e) {
        document.documentElement.classList.add('pre-skip');
      }
    })();
  </script>
  )}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': `${SITE_URL}/#abdul`,
        name: 'Abdul Rehman Khan',
        givenName: 'Abdul Rehman',
        familyName: 'Khan',
        alternateName: ['ARK Khan', 'developerark'],
        url: SITE_URL,
        image: ogImageUrl,
        jobTitle: 'Freelance Lead — Full-Stack CMS, Apps, Design & Growth',
        hasOccupation: {
          '@type': 'Occupation',
          name: 'Freelance Lead — Full-Stack CMS, Apps, Design & Growth',
          occupationalCategory: '15-1252.00',
          skills: 'CMS platforms, websites, web applications, UI design, SEO, digital marketing, Astro, Next.js, .NET, AWS, AI automation, staff augmentation',
