                { label: 'Request a quote', val: 'quote' },
                { label: 'WhatsApp Abdul', val: 'whatsapp', wa: true }
              ]
            };
          }
          if (topic === 'services' || /service|wordpress|shopify|astro|next\.?js|aws|devops|cms|automation|design|seo/.test(t)) {
            return {
