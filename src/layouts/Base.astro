          suggestToggle.setAttribute('aria-expanded', min ? 'false' : 'true');
          try { sessionStorage.setItem('arkSuggestMin', min ? '1' : '0'); } catch (e) {}
        }
        function setSuggestTitle(title) {
          if (suggestLabel) suggestLabel.textContent = title || 'Quick questions';
        }
        function setChips(list, title) {
          setSuggestTitle(title || 'Quick questions');
          chipsEl.innerHTML = '';
          (list || []).forEach(function (c) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'ark-chip' + (c.wa ? ' wa' : '') + (c.send ? ' send' : '');
            b.textContent = c.label;
            b.addEventListener('click', function () {
              if (busy || !lead) return;
              if (c.onClick) c.onClick();
              else handleUser(c.val || c.label, c.label);
            });
            chipsEl.appendChild(b);
          });
          if (suggestEl && list && list.length) applySuggestMin(false);
        }
        function suggestFor(topic, text) {
