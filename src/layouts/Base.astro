          visitorMini.hidden = false;
          visitorMini.textContent = 'Chatting as ' + name;
        }
        function setChatReady(ready) {
          if (gate) gate.hidden = !!ready;
          if (msgs) msgs.hidden = !ready;
          if (suggestEl) suggestEl.hidden = !ready;
          if (form) form.hidden = !ready;
          if (endBtn) endBtn.hidden = !ready;
          chat.classList.toggle('is-gated', !ready);
        }
        function pushLog(role, text) {
          var t = String(text || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
          if (!t) return;
          transcript.push({ role: role, text: t.slice(0, 2000) });
          transcriptSent = false;
        }
        function postLead(action) {
          if (!lead) return Promise.resolve({ ok: false });
          var payload = {
            action: action || 'start',
            name: lead.name,
            email: lead.email,
            phone: lead.phone,
            page: location.href,
            sessionId: sessionId,
            messages: (action === 'transcript' || action === 'end') ? transcript : []
          };
          var body = JSON.stringify(payload);
          if ((action === 'transcript' || action === 'end') && navigator.sendBeacon) {
            try {
              var blob = new Blob([body], { type: 'application/json' });
              if (navigator.sendBeacon('/api/chat-lead', blob)) {
                transcriptSent = true;
                return Promise.resolve({ ok: true });
              }
            } catch (e) {}
          }
          return fetch('/api/chat-lead', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: body,
            keepalive: true
          }).then(function (r) { return r.json(); }).then(function (d) {
            if ((action === 'start' || action === 'return') && d && d.ok) startNotified = true;
            if ((action === 'transcript' || action === 'end') && d && d.ok) transcriptSent = true;
            return d || { ok: false };
          }).catch(function () { return { ok: false }; });
        }
        function notifyStart(forceReturn) {
          if (!lead) return Promise.resolve({ ok: false });
          try {
            if (!forceReturn && sessionStorage.getItem('arkChatStartSent') === sessionId) {
              startNotified = true;
              return Promise.resolve({ ok: true, skipped: true });
            }
          } catch (e) {}
          if (startNotified && !forceReturn) return Promise.resolve({ ok: true, skipped: true });
          startNotified = true;
          try { sessionStorage.setItem('arkChatStartSent', sessionId); } catch (e) {}
          return postLead(forceReturn ? 'return' : 'start');
        }
        function flushTranscript(asEnd) {
          if (!lead || transcriptSent || !transcript.length) return Promise.resolve({ ok: true, skipped: true });
          return postLead(asEnd ? 'end' : 'transcript');
        }
        function resetConversation() {
          started = false;
          busy = false;
          aiHist = [];
          transcript = [];
          transcriptSent = false;
          startNotified = false;
          msgs.innerHTML = '';
          chipsEl.innerHTML = '';
          ensureSession(true);
        }
        function scroll() { msgs.scrollTop = msgs.scrollHeight; }
        function me(t) {
          var r = document.createElement('div');
          r.className = 'ark-row me';
          var who = lead && lead.name ? '<span class="ark-msg-name">' + esc(firstName(lead.name)) + '</span>' : '';
          r.innerHTML = '<div class="ark-me-wrap">' + who + '<div class="ark-bub">' + esc(t) + '</div></div>';
          msgs.appendChild(r);
