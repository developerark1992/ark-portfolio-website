---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BrandLogo from '../components/BrandLogo.astro';
import { siWhatsapp, siGithub, siFacebook, siInstagram, siX } from 'simple-icons';
const WA = '923159429998';
const WA_MSG = "Hi Abdul! I found you through your portfolio and I'd like to discuss a project.";
const LINKEDIN_PATH = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const socials = [
  { n: 'LinkedIn',  href: 'https://www.linkedin.com/in/developerark/',   path: LINKEDIN_PATH },
  { n: 'GitHub',    href: 'https://github.com/developerark1992',          path: siGithub.path },
  { n: 'WhatsApp',  href: `https://wa.me/${WA}?text=${encodeURIComponent(WA_MSG)}`, path: siWhatsapp.path },
  { n: 'Facebook',  href: 'https://www.facebook.com/ark.aries1992',       path: siFacebook.path },
  { n: 'Instagram', href: 'https://www.instagram.com/arkkhan1992',        path: siInstagram.path },
  { n: 'X',         href: 'https://x.com/official_ark92',                 path: siX.path },
];
const {
  title = 'Abdul Rehman Khan — CMS Expert & Software Engineer',
  description = 'CMS expert & software engineer — WordPress, Shopify, Webflow, Wix, Squarespace, Framer + custom Astro/Next.js. DevOps & hosting (WHM/cPanel, AWS), graphic design and AI automation. 8+ years, Karachi, open to remote EU/UK work.',
  active = 'home',
  keywords,
  ogImage = '/images/photo.webp',
  ogType = 'website',
  publishedTime,
} = Astro.props;
const SITE_URL = Astro.site || 'https://arkdesigningbureau.com';
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;
const links = [
  { href: '/',         name: 'Home',     key: 'home' },
  { href: '/about',    name: 'About',    key: 'about' },
  { href: '/projects', name: 'Projects', key: 'projects' },
  { href: '/services', name: 'Services', key: 'services' },
  { href: '/pricing',  name: 'Pricing',  key: 'pricing' },
  { href: '/blog',     name: 'Blog',     key: 'blog' },
  { href: '/estimate', name: 'Estimate', key: 'estimate' },
];
const AV = '/images/logo-icon.webp';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="Abdul Rehman Khan" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:site_name" content="Abdul Rehman Khan" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="preload" as="image" href="/images/logo-icon.webp" />
  {active === 'home' && <link rel="preload" as="image" href="/images/photo.webp?v=8" />}
  <link rel="icon" href="/images/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/images/logo-icon-192.png" />
  <style is:inline>
    html,body{margin:0;padding:0;width:100%;overflow-x:clip;}
    #preloader{position:fixed;inset:0;width:100%;height:100%;min-height:100dvh;z-index:200;background:#07080c;}
  </style>
  {ogType === 'article' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BlogPosting',
      headline: title, description, image: ogImageUrl, url: canonical,
      datePublished: publishedTime, author: { '@type': 'Person', name: 'Abdul Rehman Khan', url: SITE_URL },
      publisher: { '@type': 'Person', name: 'Abdul Rehman Khan' },
    })} />
  )}
  <ClientRouter />
</head>
<body data-av={AV} data-wa={WA}>
  <div id="preloader" class="preloader" transition:persist="ark-preloader" aria-busy="true" aria-live="polite">
    <div class="pre-sky" aria-hidden="true">
      <svg class="pre-stars" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id="preGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#c8ff5a" stop-opacity=".55"/>
            <stop offset="100%" stop-color="#c8ff5a" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <g class="pre-star-layer">
          <circle cx="8" cy="12" r=".35" fill="#fff"/><circle cx="18" cy="28" r=".25" fill="#fff"/><circle cx="32" cy="9" r=".4" fill="#c8ff5a"/>
          <circle cx="44" cy="22" r=".2" fill="#fff"/><circle cx="56" cy="14" r=".3" fill="#fff"/><circle cx="68" cy="30" r=".35" fill="#ff3d00"/>
          <circle cx="78" cy="8" r=".25" fill="#fff"/><circle cx="90" cy="20" r=".4" fill="#fff"/><circle cx="12" cy="48" r=".3" fill="#fff"/>
          <circle cx="26" cy="58" r=".2" fill="#c8ff5a"/><circle cx="40" cy="42" r=".35" fill="#fff"/><circle cx="54" cy="55" r=".25" fill="#fff"/>
          <circle cx="70" cy="48" r=".3" fill="#fff"/><circle cx="84" cy="60" r=".2" fill="#ff3d00"/><circle cx="94" cy="44" r=".35" fill="#fff"/>
          <circle cx="6" cy="72" r=".25" fill="#fff"/><circle cx="22" cy="84" r=".4" fill="#c8ff5a"/><circle cx="38" cy="76" r=".2" fill="#fff"/>
          <circle cx="52" cy="88" r=".3" fill="#fff"/><circle cx="66" cy="78" r=".25" fill="#fff"/><circle cx="82" cy="90" r=".35" fill="#fff"/>
          <circle cx="96" cy="74" r=".2" fill="#c8ff5a"/><circle cx="14" cy="36" r=".15" fill="#fff"/><circle cx="60" cy="36" r=".2" fill="#fff"/>
        </g>
      </svg>
      <svg class="pre-current" viewBox="0 0 800 600" preserveAspectRatio="none">
        <path class="pre-flow f1" d="M-40 120 C160 40 320 220 520 100 S780 60 860 140" fill="none"/>
        <path class="pre-flow f2" d="M-60 300 C140 220 360 380 560 260 S820 300 900 220" fill="none"/>
        <path class="pre-flow f3" d="M-20 480 C180 400 340 520 560 440 S800 480 880 400" fill="none"/>
      </svg>
      <div class="pre-orb pre-orb-a"></div>
      <div class="pre-orb pre-orb-b"></div>
    </div>

    <div class="preloader-inner">
      <div class="pre-ring-wrap" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="preBar">
        <svg class="pre-ring" viewBox="0 0 120 120" aria-hidden="true">
          <circle class="pre-ring-bg" cx="60" cy="60" r="52"/>
          <circle class="pre-ring-fill" id="preFill" cx="60" cy="60" r="52"/>
        </svg>
        <img class="pre-icon" src="/images/logo-icon.webp" alt="" width="88" height="88" decoding="async" fetchpriority="high" />
        <span class="pre-ring-pct" id="prePct">0</span>
      </div>
      <img class="pre-caption" src="/images/signature-modern.webp" alt="Abdul Rehman Khan" width="520" height="110" decoding="async" />
      <p class="pre-sub">Design × Software</p>
    </div>
  </div>
  <script is:inline>
    (function () {
      var CIRC = 2 * Math.PI * 52;
      var MIN_MS = 480;
      var MAX_MS = 1400;

      function preEl() { return document.getElementById('preloader'); }

      function setProgress(n) {
        var pre = preEl();
        if (!pre) return;
        var cur = parseInt(pre.dataset.progress || '0', 10);
        var progress = Math.max(cur, Math.min(100, Math.round(n)));
        pre.dataset.progress = String(progress);
        var fill = document.getElementById('preFill');
        var pctEl = document.getElementById('prePct');
        var bar = document.getElementById('preBar');
        if (fill) {
          fill.style.strokeDasharray = String(CIRC);
          fill.style.strokeDashoffset = String(CIRC * (1 - progress / 100));
        }
        if (pctEl) pctEl.textContent = String(progress);
        if (bar) bar.setAttribute('aria-valuenow', String(progress));
      }

      function show() {
        var pre = preEl();
        if (!pre) return;
        if (pre.dataset.showing === '1') return;
        pre.dataset.showing = '1';
        delete pre.dataset.done;
        pre.dataset.progress = '0';
        pre.classList.remove('done');
        pre.setAttribute('aria-busy', 'true');
        pre.style.opacity = '';
        pre.style.visibility = '';
        pre.style.pointerEvents = '';
        setProgress(6);
        pre.dataset.started = String(Date.now());
        if (pre._tick) clearInterval(pre._tick);
        pre._tick = setInterval(function () {
          if (!preEl() || pre.dataset.done === '1') {
            clearInterval(pre._tick);
            return;
          }
          var cur = parseInt(pre.dataset.progress || '0', 10);
          if (cur < 86) setProgress(cur + Math.max(1, (90 - cur) * 0.14));
        }, 28);
      }

      function hide() {
        var pre = preEl();
        if (!pre || pre.dataset.done === '1') return;
        var started = parseInt(pre.dataset.started || String(Date.now()), 10);
        var wait = Math.max(0, MIN_MS - (Date.now() - started));
        if (pre._hideTo) clearTimeout(pre._hideTo);
        pre._hideTo = setTimeout(function () {
          var node = preEl();
          if (!node || node.dataset.done === '1') return;
          if (node._tick) clearInterval(node._tick);
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduce) {
            setProgress(100);
            node.dataset.done = '1';
            node.dataset.showing = '0';
            node.setAttribute('aria-busy', 'false');
            node.classList.add('done');
            return;
          }
          var rush = setInterval(function () {
            var cur = parseInt(node.dataset.progress || '0', 10);
            setProgress(cur + Math.max(5, (100 - cur) * 0.32));
            if (parseInt(node.dataset.progress || '0', 10) >= 100) {
              clearInterval(rush);
              node.dataset.done = '1';
              node.dataset.showing = '0';
              node.setAttribute('aria-busy', 'false');
              node.classList.add('done');
            }
          }, 22);
        }, wait);
      }

      window.__arkPreShow = show;
      window.__arkPreHide = hide;

      if (!window.__arkPreBound) {
        window.__arkPreBound = true;
        document.addEventListener('astro:before-preparation', function () {
          show();
        });
        document.addEventListener('astro:page-load', function () {
          hide();
        });
      }

      var pre = preEl();
      if (pre && pre.dataset.showing !== '1' && pre.dataset.done !== '1') {
        show();
        if (document.readyState === 'interactive' || document.readyState === 'complete') {
          hide();
        } else {
          document.addEventListener('DOMContentLoaded', hide);
        }
        setTimeout(hide, MAX_MS);
      }
    })();
  </script>

  <nav class="topnav">
    <div class="nav-in">
      <a href="/" class="brand-link" aria-label="Abdul Rehman Khan — home">
        <BrandLogo />
      </a>
      <button class="navburger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navlinks">
        <span class="navburger-bars" aria-hidden="true"></span>
      </button>
      <div class="nav-scrim" id="navScrim" hidden></div>
      <div class="navlinks" id="navlinks" role="navigation" aria-label="Primary">
        <div class="nav-drawer-top">
          <a href="/" class="nav-drawer-brand" aria-label="Abdul Rehman Khan — home">
            <BrandLogo />
          </a>
          <button class="nav-close" id="navClose" type="button" aria-label="Close menu">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
        {links.map((l) => (
          <a href={l.href} class={active === l.key ? 'active' : ''}>{l.name}</a>
        ))}
        <a href="/contact" class={`cta ${active === 'contact' ? 'active' : ''}`}>Contact</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="wrap foot-top">
      <a href="/" class="foot-brand" aria-label="Abdul Rehman Khan — home">
        <BrandLogo light />
      </a>
      <div class="foot-social">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.n} title={s.n}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
    </div>
    <div class="wrap foot-in">
      <span>© <span id="yr"></span> Abdul Rehman Khan</span>
      <span>CMS Expert · Full-Stack · DevOps · Design · Automation</span>
      <a href="/contact">Let's talk →</a>
    </div>
  </footer>

  <a class="wa-float" href={`https://wa.me/${WA}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
  </a>

  <!-- global project lightbox -->
  <div class="lb" id="lb" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Project preview">
    <button class="lb-x" id="lbClose" aria-label="Close preview">×</button>
    <div class="lb-inner" id="lbInner">
      <div class="lb-shot" id="lbShot"><img id="lbImg" src="" alt="" /></div>
      <aside class="lb-side">
        <span class="lb-cat" id="lbCat"></span>
        <h3 id="lbTitle"></h3>
        <div class="lb-tags" id="lbTags"></div>
        <div class="lb-actions" id="lbActions"></div>
        <p class="lb-note mono">Full-page screenshot — scroll the preview to see the whole design.</p>
      </aside>
    </div>
  </div>

  <!-- chatbot -->
  <button class="ark-launch" id="arkLaunch" aria-label="Open chat assistant">
    <span class="pg"></span>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5h16v11H8l-4 3.5V5.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    Ask about me
  </button>
  <section class="ark-chat" id="arkChat" role="dialog" aria-label="ARK Assistant chat" hidden>
    <div class="ark-head">
      <img src={AV} alt="" width="36" height="36" decoding="async" />
      <div class="who"><b>ARK Assistant</b><span><i></i> Ask about Abdul · or hire him</span></div>
      <button class="ark-wa-btn" id="arkWa" aria-label="Message on WhatsApp" title="Message on WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
      </button>
      <button class="ark-x" id="arkClose" aria-label="Close chat">×</button>
    </div>
    <div class="ark-msgs" id="arkMsgs" aria-live="polite"></div>
    <div class="ark-chips" id="arkChips"></div>
    <form class="ark-foot" id="arkForm" autocomplete="off">
      <input id="arkInput" type="text" placeholder="Type a message…" aria-label="Message" />
      <button type="submit" aria-label="Send">→</button>
    </form>
  </section>

  <script src="/js/site.js" defer></script>
</body>
</html>
