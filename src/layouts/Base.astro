---
import '../styles/global.css';
import BrandLogo from '../components/BrandLogo.astro';
import { siWhatsapp, siGithub, siFacebook, siInstagram, siX } from 'simple-icons';
const WA = '923159429998';
const WA_MSG = "Hi Abdul! I found you through your portfolio and I'd like to discuss a project.";
const LINKEDIN_PATH = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';
const socials = [
  { n: 'LinkedIn',  href: 'https://www.linkedin.com/in/developerark/',   path: LINKEDIN_PATH },
  { n: 'GitHub',    href: 'https://github.com/developerark1992',          path: siGithub.path },
  { n: 'WhatsApp',  href: `https://wa.me/${WA}?text=${encodeURIComponent(WA_MSG)}`, path: siWhatsapp.path },
  { n: 'Facebook',  href: 'https://www.facebook.com/ark.aries1992',       path: siFacebook.path },
  { n: 'Instagram', href: 'https://www.instagram.com/arkkhan1992',        path: siInstagram.path },
  { n: 'X',         href: 'https://x.com/official_ark92',                 path: siX.path },
];
const {
  title = 'Abdul Rehman Khan — Freelance Lead · Websites, Apps, Design & Growth',
  description = 'Hire Abdul Rehman Khan — freelance lead with a mini team of freelancers. Websites, apps, design, SEO, digital marketing, CMS, AWS and AI. Also staff augmentation for startups and agencies. 13+ years since 2013. USA, Canada, UAE, UK and worldwide.',
  active = 'home',
  keywords,
  ogImage = '/images/photo.webp',
  ogType = 'website',
  publishedTime,
  faqItems = [],
} = Astro.props;
const SITE_URL = String(Astro.site || 'https://arkdesigningbureau.com').replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageUrl = new URL(ogImage, SITE_URL).href;
const links = [
  { href: '/',         name: 'Home',     key: 'home' },
  { href: '/about',    name: 'About',    key: 'about' },
  { href: '/projects', name: 'Projects', key: 'projects' },
  { href: '/services', name: 'Services', key: 'services' },
  { href: '/pricing',  name: 'Pricing',  key: 'pricing' },
  { href: '/blog',     name: 'Blog',     key: 'blog' },
  { href: '/estimate', name: 'Estimate', key: 'estimate' },
];
const AV = '/images/logo-icon.webp';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="author" content="Abdul Rehman Khan" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={canonical} />
  <link rel="alternate" hreflang="en-US" href={canonical} />
  <link rel="alternate" hreflang="en-CA" href={canonical} />
  <link rel="alternate" hreflang="en-AE" href={canonical} />
  <link rel="alternate" hreflang="en-GB" href={canonical} />
  <link rel="alternate" hreflang="x-default" href={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:site_name" content="Abdul Rehman Khan" />
  <meta property="og:locale" content="en_US" />
  <meta name="theme-color" content="#f7f8fb" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  {(active === 'home' || active === 'about') && (
    <link
      rel="preload"
      as="image"
      href="/images/photo-400.webp"
      imagesrcset="/images/photo-400.webp 400w, /images/photo-640.webp 640w"
      imagesizes="(max-width: 720px) 70vw, 520px"
      fetchpriority="high"
    />
  )}
  <link rel="icon" href="/images/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/images/logo-icon-192.png" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Machine-readable brief" />
  <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Machine-readable full brief" />
  <link rel="author" href={`${SITE_URL}/for-llms`} />
  <style is:inline>
    html,body{margin:0;padding:0;width:100%;overflow-x:clip;}
  </style>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': `${SITE_URL}/#abdul`,
        name: 'Abdul Rehman Khan',
        givenName: 'Abdul Rehman',
        familyName: 'Khan',
        alternateName: ['ARK Khan', 'developerark'],
        url: SITE_URL,
        image: ogImageUrl,
        jobTitle: 'Freelance Lead — Full-Stack CMS, Apps, Design & Growth',
        hasOccupation: {
          '@type': 'Occupation',
          name: 'Freelance Lead — Full-Stack CMS, Apps, Design & Growth',
          occupationalCategory: '15-1252.00',
          skills: 'CMS platforms, websites, web applications, UI design, SEO, digital marketing, Astro, Next.js, .NET, AWS, AI automation, staff augmentation',
        },
        description: 'Abdul Rehman Khan is a freelance lead with a mini team of freelancers (brand: ARK Designing Bureau — not a registered company). Since 2013 (13+ years) he covers websites, applications, product design, SEO, digital marketing, all major CMS platforms, Astro/Next.js, .NET, AWS/DevOps and AI. He also works with startup agencies and provides staff augmentation. Clients brief him directly; freelancers on his mini team support delivery. USA, Canada, UAE, UK and worldwide.',
        email: 'ark.educationalist@gmail.com',
        telephone: '+923159429998',
        address: { '@type': 'PostalAddress', addressLocality: 'Karachi', addressRegion: 'Sindh', addressCountry: 'PK' },
        areaServed: [
          { '@type': 'Country', name: 'United States' },
          { '@type': 'Country', name: 'Canada' },
          { '@type': 'Country', name: 'United Arab Emirates' },
          { '@type': 'Country', name: 'United Kingdom' },
          { '@type': 'AdministrativeArea', name: 'Worldwide' },
        ],
        knowsLanguage: ['en'],
        knowsAbout: [
          'CMS development', 'WordPress', 'Shopify', 'Webflow', 'Wix', 'Squarespace', 'Framer',
          'Website development', 'Web applications', 'Astro', 'Next.js', 'React', 'Full-stack engineering',
          '.NET', 'ASP.NET', 'PHP', 'AWS', 'DevOps',
          'UI/UX design', 'Figma', 'Brand design',
          'SEO', 'Technical SEO', 'Digital marketing', 'Content marketing',
          'AI engineering', 'ChatGPT', 'Claude', 'n8n',
          'Staff augmentation', 'Freelance collective', 'Startup agency partnership',
        ],
        hasCredential: {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'Professional experience',
          name: '13+ years freelance and agency web delivery since 2013',
        },
        sameAs: socials.map((s) => s.href),
        brand: { '@id': `${SITE_URL}/#brand` },
      },
      {
        '@type': ['Brand', 'ProfessionalService'],
        '@id': `${SITE_URL}/#brand`,
        name: 'ARK Designing Bureau',
        alternateName: 'ARK Designing Bureau (freelance brand — not a registered company)',
        description: 'Unregistered freelance brand of Abdul Rehman Khan and a mini team of freelancers — websites, applications, design, SEO, digital marketing, CMS, cloud and AI. Also staff augmentation for startups and agencies.',
        url: SITE_URL,
        logo: new URL('/images/logo-icon.webp', SITE_URL).href,
        image: ogImageUrl,
        email: 'ark.educationalist@gmail.com',
        telephone: '+923159429998',
        priceRange: '$$',
        currenciesAccepted: 'USD, CAD, AED, GBP, EUR, PKR',
        availableLanguage: ['English'],
        areaServed: [
          { '@type': 'Country', name: 'United States' },
          { '@type': 'Country', name: 'Canada' },
          { '@type': 'Country', name: 'United Arab Emirates' },
          { '@type': 'Country', name: 'United Kingdom' },
          { '@type': 'Place', name: 'Worldwide' },
        ],
        serviceType: [
          'Website development',
          'Web and software applications',
          'CMS platform engineering',
          'Full-stack web development',
          'Product and brand design',
          'SEO and technical SEO',
          'Digital marketing',
          'Staff augmentation for startups and agencies',
          'Astro and Next.js builds',
          '.NET applications',
          'AWS and DevOps',
          'AI engineering and automation',
        ],
        address: { '@type': 'PostalAddress', addressLocality: 'Karachi', addressCountry: 'PK' },
        sameAs: socials.map((s) => s.href),
      },
      {
        '@type': 'WebSite',
        '@id': `${SITE_URL}/#website`,
        url: SITE_URL,
        name: 'Abdul Rehman Khan',
        alternateName: 'ARK Designing Bureau',
        description: 'Official site of Abdul Rehman Khan — freelance lead with a mini team of freelancers (brand: ARK Designing Bureau, not a registered company) for websites, apps, design, SEO, digital marketing and staff augmentation.',
        publisher: { '@id': `${SITE_URL}/#abdul` },
        author: { '@id': `${SITE_URL}/#abdul` },
        inLanguage: 'en',
        about: { '@id': `${SITE_URL}/#abdul` },
      },
      {
        '@type': 'WebPage',
        '@id': `${canonical}#webpage`,
        url: canonical,
        name: title,
        description,
        isPartOf: { '@id': `${SITE_URL}/#website` },
        about: { '@id': `${SITE_URL}/#abdul` },
        author: { '@id': `${SITE_URL}/#abdul` },
        primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
        inLanguage: 'en',
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['.llm-answer', 'h1', '.page-h1', '.fx-name', '.sec-title'],
        },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
          ...(active !== 'home' ? [{ '@type': 'ListItem', position: 2, name: title, item: canonical }] : []),
        ],
      },
      ...(active === 'about' ? [{
        '@type': 'ProfilePage',
        '@id': `${canonical}#profile`,
        url: canonical,
        name: title,
        mainEntity: { '@id': `${SITE_URL}/#abdul` },
        isPartOf: { '@id': `${SITE_URL}/#website` },
      }] : []),
      ...(active === 'contact' ? [{
        '@type': 'ContactPage',
        '@id': `${canonical}#contactpage`,
        url: canonical,
        name: title,
        description,
        mainEntity: { '@id': `${SITE_URL}/#abdul` },
        isPartOf: { '@id': `${SITE_URL}/#website` },
      }] : []),
      ...(active === 'services' ? [{
        '@type': 'OfferCatalog',
        '@id': `${SITE_URL}/services#catalog`,
        name: 'Services by Abdul Rehman Khan',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website Development', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Web & Software Applications', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CMS Platform Engineering (all major CMS)', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Full-Stack Web (Astro, Next.js, React)', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Product Design & Branding', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SEO & Digital Marketing', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Staff Augmentation for Startups & Agencies', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AWS, DevOps, Hosting & .NET', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Engineering & Automation', provider: { '@id': `${SITE_URL}/#abdul` } } },
        ],
      }] : []),
      ...(faqItems.length ? [{
        '@type': 'FAQPage',
        '@id': `${canonical}#faq`,
        mainEntity: faqItems.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
        speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#faq h2', '#faq h3', '.llm-answer'] },
      }] : []),
      ...(ogType === 'article' ? [{
        '@type': 'BlogPosting',
        headline: title, description, image: ogImageUrl, url: canonical,
        datePublished: publishedTime,
        author: { '@id': `${SITE_URL}/#abdul` },
        publisher: { '@id': `${SITE_URL}/#abdul` },
      }] : []),
    ],
  })} />
</head>
<body class:list={[active === 'home' && 'has-fx-hero nav-over-hero']} data-av={AV} data-wa={WA}>

  <nav class="topnav">
    <div class="nav-in">
      <a href="/" class="brand-link" aria-label="Abdul Rehman Khan — home">
        <BrandLogo />
      </a>
      <button class="navburger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navlinks">
        <span class="navburger-bars" aria-hidden="true"></span>
      </button>
      <div class="nav-scrim" id="navScrim" hidden></div>
      <div class="navlinks" id="navlinks" role="navigation" aria-label="Primary">
        <div class="nav-drawer-top">
          <a href="/" class="nav-drawer-brand" aria-label="Abdul Rehman Khan — home">
            <BrandLogo lazy />
          </a>
          <button class="nav-close" id="navClose" type="button" aria-label="Close menu">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
        {links.map((l) => (
          <a href={l.href} class={active === l.key ? 'active' : ''}>{l.name}</a>
        ))}
        <a href="/contact" class={`cta ${active === 'contact' ? 'active' : ''}`}>Contact</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer>
    <div class="wrap foot-top">
      <a href="/" class="foot-brand" aria-label="Abdul Rehman Khan — home">
        <BrandLogo light lazy />
      </a>
      <div class="foot-social">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.n} title={s.n}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
    </div>
    <div class="wrap foot-in">
      <span>© <span id="yr"></span> Abdul Rehman Khan</span>
      <span>Freelance lead · Mini freelancers team · Staff aug · Since 2013</span>
      <a href="/contact">Let's talk →</a>
    </div>
  </footer>

  <a class="wa-float" href={`https://wa.me/${WA}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
  </a>

  <!-- global project lightbox -->
  <div class="lb" id="lb" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Project preview">
    <button class="lb-x" id="lbClose" aria-label="Close preview">×</button>
    <div class="lb-inner" id="lbInner">
      <div class="lb-shot" id="lbShot"><img id="lbImg" src="" alt="" /></div>
      <aside class="lb-side">
        <span class="lb-cat" id="lbCat"></span>
        <h3 id="lbTitle"></h3>
        <div class="lb-tags" id="lbTags"></div>
        <div class="lb-actions" id="lbActions"></div>
        <p class="lb-note mono">Full-page screenshot — scroll the preview to see the whole design.</p>
      </aside>
    </div>
  </div>

  <!-- chatbot -->
  <button class="ark-launch" id="arkLaunch" type="button">
    <span class="pg" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5h16v11H8l-4 3.5V5.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    Ask about me
  </button>
  <section class="ark-chat" id="arkChat" role="dialog" aria-label="ARK Assistant chat" hidden>
    <div class="ark-head">
      <img src={AV} alt="" width="36" height="36" decoding="async" loading="lazy" />
      <div class="who"><b>ARK Assistant</b><span><i></i> Ask about Abdul · or hire him</span></div>
      <button class="ark-wa-btn" id="arkWa" aria-label="Message on WhatsApp" title="Message on WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siWhatsapp.path} /></svg>
      </button>
      <button class="ark-x" id="arkClose" aria-label="Close chat">×</button>
    </div>
    <div class="ark-msgs" id="arkMsgs" aria-live="polite"></div>
    <div class="ark-chips" id="arkChips"></div>
    <form class="ark-foot" id="arkForm" autocomplete="off">
      <input id="arkInput" type="text" placeholder="Type a message…" aria-label="Message" />
      <button type="submit" aria-label="Send">→</button>
    </form>
  </section>

  <script src="/js/site.js" defer></script>
</body>
</html>
