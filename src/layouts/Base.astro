        email: 'ark.educationalist@gmail.com',
        telephone: '+923159429998',
        address: { '@type': 'PostalAddress', addressLocality: 'Karachi', addressRegion: 'Sindh', addressCountry: 'PK' },
        areaServed: [
          { '@type': 'Country', name: 'United States' },
          { '@type': 'Country', name: 'Canada' },
          { '@type': 'Country', name: 'United Arab Emirates' },
          { '@type': 'Country', name: 'United Kingdom' },
          { '@type': 'AdministrativeArea', name: 'Worldwide' },
        ],
        knowsLanguage: ['en'],
        knowsAbout: [
          'CMS development', 'WordPress', 'Shopify', 'Webflow', 'Wix', 'Squarespace', 'Framer',
          'Website development', 'Web applications', 'Astro', 'Next.js', 'React', 'Full-stack engineering',
          '.NET', 'ASP.NET', 'PHP', 'AWS', 'DevOps',
          'UI/UX design', 'Figma', 'Brand design',
          'SEO', 'Technical SEO', 'Digital marketing', 'Content marketing',
          'AI engineering', 'ChatGPT', 'Claude', 'n8n',
          'Staff augmentation', 'Freelance collective', 'Startup agency partnership',
        ],
        hasCredential: {
          '@type': 'EducationalOccupationalCredential',
          credentialCategory: 'Professional experience',
          name: '13+ years freelance and agency web delivery since 2013',
        },
        sameAs: socials.map((s) => s.href),
        brand: { '@id': `${SITE_URL}/#brand` },
      },
      {
        '@type': ['Brand', 'ProfessionalService'],
        '@id': `${SITE_URL}/#brand`,
        name: 'ARK Designing Bureau',
        alternateName: 'ARK Designing Bureau (freelance brand — not a registered company)',
        description: 'Unregistered freelance brand of Abdul Rehman Khan and a mini team of freelancers — websites, applications, design, SEO, digital marketing, CMS, cloud and AI. Also staff augmentation for startups and agencies.',
        url: SITE_URL,
        logo: new URL('/images/logo-icon.webp', SITE_URL).href,
        image: ogImageUrl,
        email: 'ark.educationalist@gmail.com',
        telephone: '+923159429998',
        priceRange: '$$',
        currenciesAccepted: 'USD, CAD, AED, GBP, EUR, PKR',
        availableLanguage: ['English'],
        areaServed: [
          { '@type': 'Country', name: 'United States' },
          { '@type': 'Country', name: 'Canada' },
          { '@type': 'Country', name: 'United Arab Emirates' },
          { '@type': 'Country', name: 'United Kingdom' },
          { '@type': 'Place', name: 'Worldwide' },
        ],
        serviceType: [
          'Website development',
          'Web and software applications',
          'CMS platform engineering',
          'Full-stack web development',
          'Product and brand design',
          'SEO and technical SEO',
          'Digital marketing',
          'Staff augmentation for startups and agencies',
          'Astro and Next.js builds',
          '.NET applications',
          'AWS and DevOps',
          'AI engineering and automation',
        ],
        address: { '@type': 'PostalAddress', addressLocality: 'Karachi', addressCountry: 'PK' },
        sameAs: socials.map((s) => s.href),
      },
      {
        '@type': 'WebSite',
        '@id': `${SITE_URL}/#website`,
        url: SITE_URL,
        name: 'Abdul Rehman Khan',
        alternateName: 'ARK Designing Bureau',
        description: 'Official site of Abdul Rehman Khan — freelance lead with a mini team of freelancers (brand: ARK Designing Bureau, not a registered company) for websites, apps, design, SEO, digital marketing and staff augmentation.',
        publisher: { '@id': `${SITE_URL}/#abdul` },
        author: { '@id': `${SITE_URL}/#abdul` },
        inLanguage: 'en',
        about: { '@id': `${SITE_URL}/#abdul` },
      },
      {
        '@type': 'WebPage',
        '@id': `${canonical}#webpage`,
        url: canonical,
        name: title,
        description,
        isPartOf: { '@id': `${SITE_URL}/#website` },
        about: { '@id': `${SITE_URL}/#abdul` },
        author: { '@id': `${SITE_URL}/#abdul` },
        primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
        inLanguage: 'en',
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['.llm-answer', 'h1', '.page-h1', '.fx-name', '.sec-title'],
        },
      },
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
          ...(active !== 'home' ? [{ '@type': 'ListItem', position: 2, name: title, item: canonical }] : []),
        ],
      },
      ...(active === 'about' ? [{
        '@type': 'ProfilePage',
        '@id': `${canonical}#profile`,
        url: canonical,
        name: title,
        mainEntity: { '@id': `${SITE_URL}/#abdul` },
        isPartOf: { '@id': `${SITE_URL}/#website` },
      }] : []),
      ...(active === 'contact' ? [{
        '@type': 'ContactPage',
        '@id': `${canonical}#contactpage`,
        url: canonical,
        name: title,
        description,
        mainEntity: { '@id': `${SITE_URL}/#abdul` },
        isPartOf: { '@id': `${SITE_URL}/#website` },
      }] : []),
      ...(active === 'services' ? [{
        '@type': 'OfferCatalog',
        '@id': `${SITE_URL}/services#catalog`,
        name: 'Services by Abdul Rehman Khan',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Website Development', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Web & Software Applications', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CMS Platform Engineering (all major CMS)', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Full-Stack Web (Astro, Next.js, React)', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Product Design & Branding', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SEO & Digital Marketing', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Staff Augmentation for Startups & Agencies', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AWS, DevOps, Hosting & .NET', provider: { '@id': `${SITE_URL}/#abdul` } } },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Engineering & Automation', provider: { '@id': `${SITE_URL}/#abdul` } } },
        ],
      }] : []),
      ...(faqItems.length ? [{
        '@type': 'FAQPage',
        '@id': `${canonical}#faq`,
        mainEntity: faqItems.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
        speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#faq h2', '#faq h3', '.llm-answer'] },
      }] : []),
      ...(ogType === 'article' ? [{
        '@type': 'BlogPosting',
        headline: title, description, image: ogImageUrl, url: canonical,
        datePublished: publishedTime,
        author: { '@id': `${SITE_URL}/#abdul` },
        publisher: { '@id': `${SITE_URL}/#abdul` },
      }] : []),
    ],
  })} />
  <slot name="head" />
</head>
<body class:list={[active === 'home' && 'has-fx-hero nav-over-hero', !chrome && 'crm-mode']} data-av={AV} data-wa={WA}>
  {active === 'home' && (
  <div id="preloader" class="preloader" aria-busy="true" aria-live="polite">
    <div class="pre-sky" aria-hidden="true">
      <svg class="pre-stars" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
        <g class="pre-star-layer">
          <circle cx="8" cy="12" r=".35" fill="#fff"/><circle cx="18" cy="28" r=".25" fill="#fff"/><circle cx="32" cy="9" r=".4" fill="#c8ff5a"/>
          <circle cx="44" cy="22" r=".2" fill="#fff"/><circle cx="56" cy="14" r=".3" fill="#fff"/><circle cx="68" cy="30" r=".35" fill="#ff3d00"/>
          <circle cx="78" cy="8" r=".25" fill="#fff"/><circle cx="90" cy="20" r=".4" fill="#fff"/><circle cx="12" cy="48" r=".3" fill="#fff"/>
          <circle cx="26" cy="58" r=".2" fill="#c8ff5a"/><circle cx="40" cy="42" r=".35" fill="#fff"/><circle cx="54" cy="55" r=".25" fill="#fff"/>
          <circle cx="70" cy="48" r=".3" fill="#fff"/><circle cx="84" cy="60" r=".2" fill="#ff3d00"/><circle cx="94" cy="44" r=".35" fill="#fff"/>
          <circle cx="6" cy="72" r=".25" fill="#fff"/><circle cx="22" cy="84" r=".4" fill="#c8ff5a"/><circle cx="38" cy="76" r=".2" fill="#fff"/>
          <circle cx="52" cy="88" r=".3" fill="#fff"/><circle cx="66" cy="78" r=".25" fill="#fff"/><circle cx="82" cy="90" r=".35" fill="#fff"/>
        </g>
      </svg>
      <svg class="pre-current" viewBox="0 0 800 600" preserveAspectRatio="none">
        <path class="pre-flow f1" d="M-40 120 C160 40 320 220 520 100 S780 60 860 140" fill="none"/>
        <path class="pre-flow f2" d="M-60 300 C140 220 360 380 560 260 S820 300 900 220" fill="none"/>
        <path class="pre-flow f3" d="M-20 480 C180 400 340 520 560 440 S800 480 880 400" fill="none"/>
      </svg>
      <div class="pre-orb pre-orb-a"></div>
      <div class="pre-orb pre-orb-b"></div>
    </div>
    <div class="preloader-inner">
      <div class="pre-ring-wrap" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Loading" id="preBar">
        <svg class="pre-ring" viewBox="0 0 120 120" aria-hidden="true">
          <circle class="pre-ring-bg" cx="60" cy="60" r="52"/>
          <circle class="pre-ring-fill" id="preFill" cx="60" cy="60" r="52"/>
        </svg>
        <img class="pre-icon" data-src="/images/logo-icon.webp" alt="" width="88" height="88" decoding="async" />
        <span class="pre-ring-pct" id="prePct">0</span>
      </div>
      <img class="pre-caption" data-src="/images/signature-modern.webp" alt="Abdul Rehman Khan" width="280" height="48" decoding="async" />
      <p class="pre-sub">Design × Software</p>
    </div>
  </div>
  <script is:inline>
    (function () {
      var CIRC = 2 * Math.PI * 52;
      var reduce = false;
      try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var MAX_MS = reduce ? 900 : 2200;
      var pre = document.getElementById('preloader');
      if (!pre) return;

      window.__arkPreHide = function () {
        if (pre.dataset.done === '1') return;
        pre.dataset.done = '1';
        pre.setAttribute('aria-busy', 'false');
        pre.classList.add('done');
      };

      function setProgress(n) {
        var progress = Math.max(0, Math.min(100, Math.round(n)));
        pre.dataset.progress = String(progress);
        var fill = document.getElementById('preFill');
        var pctEl = document.getElementById('prePct');
        var bar = document.getElementById('preBar');
        if (fill) {
          fill.style.strokeDasharray = String(CIRC);
          fill.style.strokeDashoffset = String(CIRC * (1 - progress / 100));
        }
        if (pctEl) pctEl.textContent = String(progress);
        if (bar) bar.setAttribute('aria-valuenow', String(progress));
      }

      function finish() {
        setProgress(100);
        window.__arkPreHide();
      }

      if (document.documentElement.classList.contains('pre-skip') ||
          !document.documentElement.classList.contains('pre-on')) {
        finish();
        return;
      }

      /* Hydrate assets only for real visitors — avoid competing with LCP in Lighthouse. */
      pre.querySelectorAll('[data-src]').forEach(function (img) {
        img.setAttribute('src', img.getAttribute('data-src'));
        img.removeAttribute('data-src');
      });

      if (!reduce) pre.classList.add('is-live');
      setProgress(6);
      var started = Date.now();
      var tick = setInterval(function () {
        if (pre.dataset.done === '1') { clearInterval(tick); return; }
        var elapsed = Date.now() - started;
        var target = Math.min(94, Math.round((elapsed / MAX_MS) * 94));
        var cur = parseInt(pre.dataset.progress || '0', 10);
        if (target > cur) setProgress(target);
        if (elapsed >= MAX_MS) {
          clearInterval(tick);
          finish();
        }
      }, 32);

      /* Always hold for MAX_MS so the intro is visible even on a warm cache. */
      window.addEventListener('load', function () {
        var left = Math.max(0, MAX_MS - (Date.now() - started));
        setTimeout(function () {
          clearInterval(tick);
          finish();
        }, left);
      }, { once: true });
    })();
  </script>
  )}

  {chrome && (
  <nav class="topnav">
    <div class="nav-in">
      <a href="/" class="brand-link" aria-label="Abdul Rehman Khan — home">
        <BrandLogo prefer={active === 'home' ? 'dark' : 'light'} />
      </a>
      <button class="navburger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navlinks">
        <span class="navburger-bars" aria-hidden="true"></span>
      </button>
      <div class="nav-scrim" id="navScrim" hidden></div>
