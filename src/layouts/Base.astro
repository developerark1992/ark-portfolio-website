        function typing() {
          untype();
          var r = document.createElement('div');
          r.className = 'ark-row bot';
          r.id = 'arkT';
          r.innerHTML = '<img src="' + AV + '" alt=""><div class="ark-bub"><span class="ark-typing"><i></i><i></i><i></i></span></div>';
          msgs.appendChild(r);
          scroll();
        }
        function applySuggestMin(min) {
          if (!suggestEl || !suggestToggle) return;
