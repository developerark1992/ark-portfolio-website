---
import Base from '../layouts/Base.astro';
import IconChip from '../components/IconChip.astro';
import { groups } from '../data/tech.mjs';
import { experience, YEARS_EXPERIENCE, CAREER_START, CAREER_TAGLINE } from '../data/experience.mjs';
import '../styles/ci-home.css';

const skillAccents = {
  cyan: '#22d3ee',
  violet: '#a78bfa',
};
---
<Base active="about" title="About Abdul Rehman Khan — Full-Stack CMS & AI Engineer" description={`Abdul Rehman Khan is a full-stack CMS & AI engineer with ${YEARS_EXPERIENCE} years experience since ${CAREER_START} — one-person operator for all major CMS platforms, Astro, Next.js, .NET, design, AWS and AI. USA, Canada, UAE, UK and worldwide.`} keywords="Abdul Rehman Khan, full-stack CMS engineer since 2013, AI engineer, Astro Next.js .NET AWS, one man army developer">
  <section>
    <div class="wrap about-hero">
      <div class="about-photo reveal"><img src="/images/photo.webp?v=8" alt="Abdul Rehman Khan — full-stack CMS and AI engineer since 2013" width="620" height="740" loading="lazy" decoding="async" /></div>
      <div class="reveal">
        <p class="eyebrow">About me · {CAREER_TAGLINE}</p>
        <h1 class="sec-title" style="font-size:clamp(30px,4.6vw,48px);">A one-man technical army — CMS, full-stack, design, cloud and AI.</h1>
        <p class="sec-lead" style="margin:18px 0 24px;">Based in Karachi, working remotely with the <b>United States, Canada, the UAE, the UK</b> and clients in every other country. <b>Since {CAREER_START}</b> ({YEARS_EXPERIENCE} years) I've engineered across <b>every major CMS</b> — WordPress, Shopify, Webflow, Wix, Squarespace, Framer — plus <b>Astro, Next.js, React, .NET</b>, product design, <b>AWS</b>/WHM hosting, and <b>AI engineering</b> (Claude, ChatGPT, n8n agents).</p>
        <p class="sec-lead">Most clients hire a CMS specialist, a full-stack engineer, a designer, a cloud admin and an AI consultant. I'm all of them — one accountable operator, fewer hand-offs, and a product that still stands after launch day.</p>
        <div class="hero-cta" style="margin-top:26px;">
          <a class="btn primary" href="/Abdul-Rehman-Khan-CV.pdf" download>Download résumé ↓</a>
          <a href="/contact" class="btn ghost">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="reveal" style="margin-bottom:20px;"><p class="eyebrow">Career journey · {CAREER_START}–present</p><h2 class="sec-title">Where I've worked</h2>
      <p class="sec-lead" style="margin-top:8px;">{YEARS_EXPERIENCE} years from founding freelance years to senior CMS, full-stack, cloud and AI delivery.</p></div>
      <div class="journey">
        {experience.map((e) => (
          <div class="jitem reveal"><div class="when">{e.when}</div><h3>{e.role}</h3><div class="co">{e.co}</div><p>{e.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="ci-section" id="skills">
    <div class="wrap ci-split is-half">
      <div class="ci-sticky reveal">
        <div class="ci-head">
          <div class="ci-label-row">
            <span class="ci-label">Expertise</span>
            <span class="ci-label-rule" aria-hidden="true"></span>
            <span class="ci-label ci-label-accent">Skills</span>
          </div>
          <h2>Skills &amp; <em>tools</em></h2>
          <p class="ci-lead">Every layer I ship with — all major CMS platforms, Astro/Next.js, .NET, AI engineering, design, AWS and hosting — stacked so you can scroll through one craft at a time.</p>
        </div>
      </div>

      <ol class="svc-deck skill-deck" data-stack data-stack-noshrink>
        {groups.map((g, i) => (
          <li class="svc-slot" style={`--i:${i}`}>
            <article
              class="skill-stack-card"
              data-stack-card
              style={`--accent:${skillAccents[g.tone] || skillAccents.cyan}; --i:${i}`}
            >
              <span class="num">{g.n}</span>
              <h3>{g.t}</h3>
              <div class="skill-pills">
                {g.items.map((t) => (
                  <IconChip label={t.label} path={t.path} tone={g.tone} />
                ))}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap about-edu">
      <div class="reveal edu-card">
        <p class="eyebrow" style="margin-bottom:16px;">Education</p>
        <h3>Bachelor of Software Engineering</h3>
        <div class="meta">Iqra University, Pakistan · 2022 · CGPA 3.16</div>
      </div>
      <div class="reveal edu-card">
        <p class="eyebrow" style="margin-bottom:16px;">Certifications</p>
        <div class="cert-list">
          <span>WordPress SEO — Coursera</span><span>Build a Website — Coursera</span><span>Google Analytics — Skillshop</span><span>Wix — Coursera</span><span>OpenCart — Mind Luster</span><span>Webflow — Coursera</span><span>Adobe XD — LinkedIn Learning</span><span>Aptech ACCP</span>
        </div>
      </div>
    </div>
  </section>
</Base>
