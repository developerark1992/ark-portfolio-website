---
import Base from '../layouts/Base.astro';
---
<Base active="estimate" title="Estimate — Abdul Rehman Khan" description="Instant website cost calculator — build your project and get a live estimate.">
  <section id="page-estimate" class="page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">Instant estimate</p>
      <h1 class="reveal page-h1">What will it cost?</h1>
      <p class="sec-lead reveal" style="margin-bottom:8px;">Build your project below and watch the price update live. The <em>stack you pick changes the price</em> — WordPress is the most affordable, Shopify and custom builds cost more. Your exact quote comes after a quick chat.</p>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap calc-grid">
      <div class="calc-controls">
        <div class="calc-block reveal">
          <div class="calc-label"><span class="calc-num">01</span> Project type</div>
          <div class="seg" data-group="type">
            <button class="seg-btn active" data-val="website">Website</button>
            <button class="seg-btn" data-val="webapp">Web app</button>
            <button class="seg-btn" data-val="ecommerce">E-commerce</button>
            <button class="seg-btn" data-val="saas">SaaS platform</button>
            <button class="seg-btn" data-val="mvp">MVP / prototype</button>
          </div>
        </div>
        <div class="calc-block reveal">
          <div class="calc-label"><span class="calc-num">02</span> Platform / stack</div>
          <div class="chips" data-group="platform">
            <button class="chip-b active" data-val="wordpress">WordPress</button>
            <button class="chip-b" data-val="wix">Wix</button>
            <button class="chip-b" data-val="squarespace">Squarespace</button>
            <button class="chip-b" data-val="webflow">Webflow</button>
            <button class="chip-b" data-val="framer">Framer</button>
            <button class="chip-b" data-val="shopify">Shopify</button>
            <button class="chip-b" data-val="custom">Custom (Astro / Next.js)</button>
          </div>
        </div>
        <div class="calc-block reveal">
          <div class="calc-label"><span class="calc-num">03</span> Complexity</div>
          <div class="chips" data-group="complexity">
            <button class="chip-b active" data-val="simple">Simple</button>
            <button class="chip-b" data-val="medium">Medium</button>
            <button class="chip-b" data-val="complex">Complex</button>
            <button class="chip-b" data-val="enterprise">Enterprise</button>
          </div>
        </div>
        <div class="calc-block reveal">
          <div class="calc-label"><span class="calc-num">04</span> Pages / screens <b id="pageVal">5</b></div>
          <input type="range" id="pageRange" min="1" max="50" value="5" class="calc-range" />
          <div class="calc-scale"><span>1</span><span>25</span><span>50+</span></div>
        </div>
        <div class="calc-block reveal">
          <div class="calc-label"><span class="calc-num">05</span> Features</div>
          <div class="chips multi" data-group="features">
            <button class="chip-b" data-val="auth">User authentication</button>
            <button class="chip-b" data-val="payments">Payment integration</button>
            <button class="chip-b" data-val="api">Third-party API</button>
            <button class="chip-b" data-val="dashboard">Admin dashboard</button>
            <button class="chip-b" data-val="analytics">Analytics &amp; reporting</button>
            <button class="chip-b" data-val="cms">CMS</button>
            <button class="chip-b" data-val="responsive">Mobile responsive</button>
            <button class="chip-b" data-val="seo">SEO optimization</button>
            <button class="chip-b" data-val="multilang">Multi-language</button>
            <button class="chip-b" data-val="realtime">Real-time features</button>
          </div>
        </div>
        <div class="calc-block reveal">
          <div class="calc-label"><span class="calc-num">06</span> Timeline</div>
          <div class="chips" data-group="timeline">
            <button class="chip-b" data-val="rush">Rush (1–2 wks)</button>
            <button class="chip-b" data-val="fast">Fast (2–4 wks)</button>
            <button class="chip-b active" data-val="standard">Standard (1–2 mo)</button>
            <button class="chip-b" data-val="flexible">Flexible (2–4 mo)</button>
          </div>
        </div>
      </div>

      <aside class="calc-result reveal">
        <div class="calc-card">
          <div class="calc-card-top">
            <span class="calc-est-label">Estimated investment</span>
            <div class="cur-toggle" data-group="currency">
              <button class="cur-b active" data-val="PKR">PKR</button>
              <button class="cur-b" data-val="USD">USD</button>
              <button class="cur-b" data-val="EUR">EUR</button>
              <button class="cur-b" data-val="GBP">GBP</button>
              <button class="cur-b" data-val="AED">AED</button>
              <button class="cur-b" data-val="INR">INR</button>
            </div>
          </div>
          <div class="calc-figure"><span id="estPrice">0</span></div>
          <div class="calc-est-sub">Estimated project price · <span id="estPlatform">WordPress</span></div>
          <div class="calc-gauge"><div class="calc-gauge-fill" id="gaugeFill"></div></div>
          <div class="calc-gauge-cap"><span>Simple</span><span id="scopeLabel">Standard build</span><span>Complex</span></div>
          <ul class="calc-breakdown" id="breakdown"></ul>
          <div class="calc-actions">
            <a id="calcQuote" class="btn primary" href="#">Request exact quote →</a>
            <button id="calcChat" class="btn ghost" type="button">Discuss with assistant</button>
          </div>
          <p class="calc-note">Indicative only. Final scope &amp; price are confirmed after a short call — no obligation.</p>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    (function () {
      var EMAIL = 'ark.educationalist@gmail.com';
      function bootCalc() {
        var page = document.querySelector('.calc-grid');
        var priceEl = document.getElementById('estPrice');
        if (!page || !priceEl || page.dataset.inlineBound === '1') return;
        page.dataset.inlineBound = '1';
        page.dataset.bound = '1';

        var TYPES = { website: { base: 100000, incl: 5, label: 'Website' }, webapp: { base: 400000, incl: 6, label: 'Web app' }, ecommerce: { base: 250000, incl: 8, label: 'E-commerce' }, saas: { base: 900000, incl: 6, label: 'SaaS platform' }, mvp: { base: 350000, incl: 5, label: 'MVP / prototype' } };
        var PER_PAGE = 15000;
        var PLATFORM = { wordpress: 1, wix: 1.05, squarespace: 1.1, webflow: 1.2, framer: 1.2, shopify: 1.3, custom: 1.6, _label: { wordpress: 'WordPress', wix: 'Wix', squarespace: 'Squarespace', webflow: 'Webflow', framer: 'Framer', shopify: 'Shopify', custom: 'Custom (Astro / Next.js)' } };
        var COMPLEXITY = { simple: 1, medium: 1.3, complex: 1.7, enterprise: 2.4, _label: { simple: 'Simple', medium: 'Medium', complex: 'Complex', enterprise: 'Enterprise' } };
        var FEAT = { auth: 60000, payments: 120000, api: 90000, dashboard: 150000, analytics: 80000, cms: 90000, responsive: 40000, seo: 60000, multilang: 100000, realtime: 150000 };
        var FEAT_LABEL = { auth: 'User authentication', payments: 'Payment integration', api: 'Third-party API', dashboard: 'Admin dashboard', analytics: 'Analytics & reporting', cms: 'CMS', responsive: 'Mobile responsive', seo: 'SEO optimization', multilang: 'Multi-language', realtime: 'Real-time features' };
        var CUR = {
          PKR: { m: 1, s: '₨', step: 2000 }, USD: { m: 1 / 281, s: '$', step: 10 }, EUR: { m: 1 / 305, s: '€', step: 10 },
          GBP: { m: 1 / 356, s: '£', step: 10 }, AED: { m: 1 / 76, s: 'AED ', step: 25 }, INR: { m: 1 / 3.37, s: '₹', step: 100 }
        };
        function autoCurrency() {
          try {
            var tz = (Intl.DateTimeFormat().resolvedOptions().timeZone) || '';
            var map = { 'Asia/Karachi': 'PKR', 'Asia/Dubai': 'AED', 'Asia/Kolkata': 'INR', 'Europe/London': 'GBP' };
            if (map[tz]) return map[tz];
            if (/^Europe\//.test(tz)) return 'EUR';
            if (/^America\//.test(tz)) return 'USD';
          } catch (e) {}
          return 'PKR';
        }
        var state = { type: 'website', platform: 'wordpress', pages: 5, complexity: 'simple', features: {}, timeline: 'standard', currency: autoCurrency() };
        var $ = function (id) { return document.getElementById(id); };
        function roundTo(n, s) { return Math.round(n / s) * s; }
        function fmtVal(v) { var c = CUR[state.currency] || CUR.USD; return c.s + roundTo(v * c.m, c.step || 50).toLocaleString('en-US'); }
        function compute() {
          var t = TYPES[state.type], price = t.base, extra = Math.max(0, state.pages - t.incl);
          var bd = [{ l: t.label + ' · base', v: fmtVal(t.base) }];
          price += extra * PER_PAGE;
          if (extra > 0) bd.push({ l: extra + ' extra page' + (extra > 1 ? 's' : ''), v: '+' + fmtVal(extra * PER_PAGE) });
          Object.keys(state.features).forEach(function (k) { if (!state.features[k]) return; var r = FEAT[k]; if (r) { price += r; bd.push({ l: FEAT_LABEL[k], v: '+' + fmtVal(r) }); } });
          var cm = COMPLEXITY[state.complexity]; price *= cm;
          if (state.complexity !== 'simple') bd.push({ l: COMPLEXITY._label[state.complexity] + ' complexity', v: '×' + cm });
          var pm = PLATFORM[state.platform]; price *= pm;
          bd.push({ l: PLATFORM._label[state.platform] + ' platform', v: pm === 1 ? 'base rate' : '×' + pm });
          if (state.timeline === 'rush') { price *= 1.5; bd.push({ l: 'Rush timeline', v: '+50%' }); }
          else if (state.timeline === 'flexible') { price *= 0.9; bd.push({ l: 'Flexible timeline', v: '−10%' }); }
          price = Math.max(100000, price);
          return { price: price, scope: Math.max(0, Math.min(1, (price - 100000) / (6000000 - 100000))), breakdown: bd };
        }
        function render() {
          var r = compute();
          priceEl.textContent = fmtVal(r.price);
          var pl = $('estPlatform'); if (pl) pl.textContent = PLATFORM._label[state.platform];
          var gf = $('gaugeFill'); if (gf) gf.style.width = (12 + r.scope * 88) + '%';
          var sl = $('scopeLabel'); if (sl) sl.textContent = r.scope < 0.22 ? 'Simple build' : r.scope < 0.48 ? 'Standard build' : r.scope < 0.74 ? 'Advanced build' : 'Complex build';
          var bd = $('breakdown'); if (bd) bd.innerHTML = r.breakdown.map(function (b) { return '<li><span>' + b.l + '</span><span>' + b.v + '</span></li>'; }).join('');
          var rng = $('pageRange'); if (rng) rng.style.setProperty('--fill', ((rng.value - rng.min) / (rng.max - rng.min) * 100) + '%');
        }
        page.addEventListener('click', function (e) {
          var b = e.target.closest('button[data-val]'); if (!b) return;
          var group = b.parentElement.getAttribute('data-group');
          if (group === 'features') { var v = b.getAttribute('data-val'); state.features[v] = !state.features[v]; b.classList.toggle('active', state.features[v]); }
          else if (group) {
            b.parentElement.querySelectorAll('button').forEach(function (x) { x.classList.toggle('active', x === b); });
            var val = b.getAttribute('data-val');
            if (group === 'type') state.type = val;
            else if (group === 'platform') state.platform = val;
            else if (group === 'complexity') state.complexity = val;
            else if (group === 'timeline') state.timeline = val;
            else if (group === 'currency') state.currency = val;
          }
          render();
        });
        var range = $('pageRange');
        if (range) range.addEventListener('input', function () {
          state.pages = +this.value;
          var pv = $('pageVal'); if (pv) pv.textContent = this.value >= 50 ? '50+' : this.value;
          render();
        });
        var quote = $('calcQuote');
        if (quote) quote.addEventListener('click', function (e) {
          e.preventDefault();
          var r = compute();
          var feats = Object.keys(state.features).filter(function (k) { return state.features[k]; }).map(function (k) { return FEAT_LABEL[k]; }).join(', ') || 'none';
          var subject = 'Website quote request — ' + TYPES[state.type].label;
          var body = 'Hi Abdul, I used your calculator — here\'s my project:\n\nProject type: ' + TYPES[state.type].label + '\nPlatform: ' + PLATFORM._label[state.platform] + '\nComplexity: ' + COMPLEXITY._label[state.complexity] + '\nPages / screens: ' + state.pages + '\nFeatures: ' + feats + '\nTimeline: ' + state.timeline + '\n\nEstimated price shown: ' + fmtVal(r.price) + '\n\nPlease send me an exact quote.';
          window.location.href = 'mailto:' + EMAIL + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
        });
        var chat = $('calcChat');
        if (chat) chat.addEventListener('click', function () { if (window.arkOpenChat) window.arkOpenChat(); });
        var curWrap = document.querySelector('[data-group="currency"]');
        if (curWrap) {
          var m = curWrap.querySelector('[data-val="' + state.currency + '"]');
          curWrap.querySelectorAll('button').forEach(function (x) { x.classList.toggle('active', x === m); });
        }
        render();
      }
      document.addEventListener('astro:page-load', bootCalc);
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bootCalc);
      else bootCalc();
    })();
  </script>
</Base>
