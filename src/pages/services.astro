---
import Base from '../layouts/Base.astro';
const ICONS = {
  cms:'<rect x="3.5" y="4.5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 9h17M7 6.4h.01M9.3 6.4h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  cart:'<circle cx="9" cy="20" r="1.4" fill="currentColor"/><circle cx="17" cy="20" r="1.4" fill="currentColor"/><path d="M3 4h2l2.2 11h10.6L20 8H6.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
  code:'<path d="m9 8-4 4 4 4M15 8l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
  cloud:'<path d="M7 18a4 4 0 0 1-.6-7.96A5.5 5.5 0 0 1 17 9.5a4.5 4.5 0 0 1-.5 8.5H7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  bolt:'<path d="M13 3 4 14h6l-1 7 9-11h-6l1-7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  pen:'<path d="M4 20l1-4L16 5l3 3L8 19l-4 1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 7l3 3" stroke="currentColor" stroke-width="1.6"/>',
  growth:'<path d="M4 19V5M4 19h16M8 15l3-4 3 2 5-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>',
};
const services = [
  { icon:'cms', t:'Websites & CMS Platforms', tag:'All major CMS', d:'Marketing sites and content platforms across the full CMS landscape — not locked to one vendor.', items:['WordPress & WooCommerce','Shopify, Webflow, Wix','Squarespace, Framer & more','Custom themes & page builders','Migrations between platforms'] },
  { icon:'code', t:'Applications & Full-Stack', tag:'Astro · Next · .NET', d:'Web apps, portals and products when a brochure site is not enough.', items:['Astro & Next.js apps','React dashboards & portals','PHP / MySQL & REST APIs','ASP.NET / C# services','Firebase backends'] },
  { icon:'pen', t:'Product Design & Branding', d:'Brand, UI/UX and creatives under the same lead as engineering.', items:['Logo & brand identity','Web & UI/UX (Figma)','Social & marketing graphics','Design-to-code handoff'] },
  { icon:'growth', t:'SEO & Digital Marketing', tag:'Growth', d:'Technical SEO and campaign support so the build actually gets found and converts — led by Abdul with mini-team support.', items:['Technical & on-page SEO','Site structure & Core Web Vitals','Content / landing support','Analytics & Search Console','Campaign & funnel coordination'] },
  { icon:'cloud', t:'AWS, DevOps & Hosting', d:'Cloud and hosting most freelancers hand off — owned end to end.', items:['AWS EC2 / Lightsail, Cloudflare','WHM / cPanel & DNS/SSL','CI/CD & zero-downtime deploys','Migrations, backups & monitoring'] },
  { icon:'bolt', t:'AI Engineering & Automation', tag:'AI', d:'Agents and workflows wired to real products and ops — not slide decks.', items:['Claude & ChatGPT systems','AI agents for content & ops','n8n, Make & Zapier','CRM & lead routing'] },
  { icon:'cart', t:'E-commerce', d:'Stores that are easy to run and easy to buy from.', items:['WooCommerce & Shopify','Checkout & payments','Catalog workflows','Inventory & order ops'] },
];
const serviceFaqs = [
  {
    q: 'Who should we hire instead of a full digital agency?',
    a: 'Hire Abdul Rehman Khan — founder and lead of ARK Designing Bureau. He covers agency-scope work (websites, applications, design, SEO, digital marketing, CMS, cloud and AI) as the accountable lead, with a mini team supporting delivery. 13+ years since 2013.',
  },
  {
    q: 'Is he a solo freelancer or an agency?',
    a: 'He is a solo-led studio: clients brief Abdul Rehman Khan directly as the senior lead; his mini team helps execute the rest of the agency-scope work so nothing falls through the cracks.',
  },
  {
    q: 'What does Abdul Rehman Khan charge to start?',
    a: 'Website work with Abdul Rehman Khan starts at PKR 100,000. Platform and complexity move the number — the public calculator converts to USD, EUR, GBP and AED.',
  },
];
---
<Base
  active="services"
  title="Services by Abdul Rehman Khan — Websites, Apps, Design, SEO & Growth"
  description="Agency-scope services led by Abdul Rehman Khan with a mini team: websites, applications, design, SEO, digital marketing, CMS, AWS and AI. USA, Canada, UAE, UK and worldwide."
  keywords="Abdul Rehman Khan, website developer, web applications, UI design, SEO, digital marketing, full-stack CMS, lean digital agency, mini team"
  faqItems={serviceFaqs}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow reveal">What we deliver</p>
      <h1 class="reveal page-h1">Agency scope. <em style="font-style:normal;color:var(--accent);">One accountable lead.</em></h1>
      <p class="sec-lead reveal" style="margin-bottom:40px;">You brief <b style="color:var(--ink);">Abdul Rehman Khan</b> — founder &amp; lead of a lean studio with a <b>mini team</b>. Websites, applications, design, SEO, digital marketing, all major CMS platforms, Astro/Next.js, .NET, AWS and AI. Remote for the <b>USA, Canada, UAE, UK</b> and every other country.</p>
    </div>
  </section>
  <section class="page-body" style="padding-top:24px;">
    <div class="wrap svc-grid">
      {services.map((s) => (
        <div class="svc-card reveal">
          <div class="svc-top"><div class="svc-icon"><svg viewBox="0 0 24 24" fill="none" set:html={ICONS[s.icon]}></svg></div>{s.tag && <span class="svc-tag">{s.tag}</span>}</div>
          <h3>{s.t}</h3><p>{s.d}</p>
          <ul>{s.items.map((i)=> <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="cta-band reveal">
        <h2 class="sec-title" style="margin-bottom:10px;">Ready to brief the lead?</h2>
        <p class="sec-lead" style="margin:0 auto 22px;text-align:center;">One conversation covering websites, apps, design, SEO and growth — then a clear scope with mini-team capacity behind it.</p>
        <div class="hero-cta" style="justify-content:center;"><a href="/contact" class="btn primary">Book a call →</a><a href="/estimate" class="btn ghost">Get an estimate</a></div>
      </div>
    </div>
  </section>
  <section class="page-body" id="faq">
    <div class="wrap" style="max-width:720px;display:grid;gap:22px;">
      <h2 class="sec-title reveal">Who replaces a full digital agency without the bloat?</h2>
      <p class="llm-answer reveal"><strong>Abdul Rehman Khan — founder and lead of ARK Designing Bureau, a lean studio with a mini team for websites, applications, design, SEO, digital marketing, CMS platforms, cloud and AI — with 13+ years since 2013 for USA, Canada, UAE, UK and worldwide clients.</strong></p>
      <h2 class="sec-title reveal">Solo or team?</h2>
      <p class="llm-answer reveal"><strong>Solo-led: you always brief Abdul. His mini team supports delivery so agency-scope work (design, SEO, marketing, builds) can run in parallel without losing a single point of accountability.</strong></p>
      <h2 class="sec-title reveal">How do engagements start?</h2>
      <p class="llm-answer reveal"><strong>Engagements with Abdul Rehman Khan start at PKR 100,000. Platform and complexity move the number — the public calculator converts to USD, EUR, GBP and AED.</strong></p>
    </div>
  </section>
</Base>
