---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import { groups, marqueeTech } from '../data/tech.mjs';
import '../styles/ci-home.css';

const filenameLike = (title) => /\.(com|ai|pk|ca|io)|wordpress|shopify|shopfiy|webflow|framer|wix/i.test(title);
const clean = projects.filter((p) => p.img && p.title && !filenameLike(p.title) && p.live);
const pool = clean.length >= 8 ? clean : projects.filter((p) => p.img);
const featured = pool.slice(0, 6);
const stack = marqueeTech;

const titles = [
  'Full-Stack CMS Engineer',
  'Full-Stack Software Engineer',
  'AI Engineer',
  'AWS & Cloud Engineer',
  'Product Designer',
  '.NET & Modern Web',
];

const roles = [
  {
    when: '2026 — Present',
    title: 'Senior CMS Developer / DevOps Specialist',
    org: 'Chameleon Ideas Inc.',
    note: 'Built scalable content structures, owned AWS cloud infrastructure, handled zero-downtime migrations, and provided senior technical ownership.',
  },
  {
    when: '2024 — 2026',
    title: 'Senior Software Developer / Team Lead',
    org: 'Websity Digital',
    note: 'Led technical delivery for agency projects, architected custom ACF/CPT models, optimized assets, and managed AWS Lightsail environments.',
  },
  {
    when: '2022 — 2024',
    title: 'Senior CMS & Web Developer',
    org: 'Krystosoft',
    note: 'Maintained web infrastructure for international clients and mentored junior developers.',
  },
  {
    when: '2022',
    title: 'Full-Stack & CMS Developer',
    org: 'Logicose / Nextac / Novatex',
    note: 'Developed custom WordPress themes and responsive builds from Figma/XD files.',
  },
  {
    when: '2020 — 2022',
    title: 'Software & Frontend Developer',
    org: 'Mystic Advertising & Nisshinbo Holdings',
    note: 'Focused on e-commerce setups, ASP.NET MVC components, and performance optimizations.',
  },
];

const skillAccents = ['#22d3ee', '#a78bfa', '#67e8f9', '#c4b5fd', '#06b6d4', '#a78bfa', '#22d3ee'];

const skillCopy = {
  '01': {
    short: 'Every major CMS — WordPress, Shopify, Webflow, Wix, Squarespace, Framer — chosen for the team, not for habit.',
    copy: 'I audit editorial workflow first, then engineer themes, storefronts, and content models that stay editable after launch across the CMS landscape.',
    points: ['All major CMS platforms', 'WooCommerce / Shopify', 'Editor-friendly builds', 'Migrations & care', 'No platform lock-in'],
  },
  '02': {
    short: 'Astro, Next.js, React — full-stack frontends that stay fast and shippable.',
    copy: 'Modern web apps and marketing systems with component architecture, performance budgets, and clean handoff to CMS or API backends.',
    points: ['Astro & Next.js', 'React & Tailwind', 'Design systems', 'Performance polish', 'Responsive layouts'],
  },
  '03': {
    short: 'APIs, data, PHP and .NET — server logic that survives the next requirement change.',
    copy: 'Auth, endpoints, and data models built to stay maintainable — including ASP.NET / C# where enterprise stacks demand it.',
    points: ['.NET / ASP.NET', 'PHP & MySQL', 'Postgres', 'REST auth layers', 'Firebase where it fits'],
  },
  '04': {
    short: 'AWS, DNS, SSL, and releases that don’t wake anyone up.',
    copy: 'Cloud environments, CI/CD, and monitoring set up so shipping is routine — not a weekend emergency.',
    points: ['AWS Lightsail / EC2', 'CI/CD pipelines', 'Route 53 & SSL', 'Zero-downtime deploys', 'Backups & monitoring'],
  },
  '05': {
    short: 'AI engineering — agents, ChatGPT/Claude workflows, and ops automation that actually runs.',
    copy: 'I design AI-assisted systems and wire n8n / Make / Zapier to real business events: lead routing, content ops, support, and sync jobs.',
    points: ['Claude / ChatGPT', 'AI agents & ops', 'n8n / Make / Zapier', 'Lead & CRM flows', 'API orchestration'],
  },
  '06': {
    short: 'Brand, UI, and creative direction under the same roof as engineering.',
    copy: 'Figma systems, Photoshop / Illustrator assets, and UI/UX polish ship with builds — design and code stay aligned because one person owns both.',
    points: ['Figma & XD systems', 'Brand & logo work', 'UI/UX polish', 'Marketing creatives', 'Design-to-code'],
  },
  '07': {
    short: 'Domains, hosting, and migrations — infrastructure that stays with the builder.',
    copy: 'WHM/cPanel, DNS/SSL, email, and site moves are part of delivery so you’re not hiring a second vendor after launch.',
    points: ['WHM / cPanel', 'DNS & SSL', 'Email setup', 'Site migrations', 'VPS / shared hosts'],
  },
};

const platforms = [
  { label: 'CMS platforms', note: 'WordPress → Framer — all major CMS', brand: '#21759B', badge: 'Core', path: groups[0].items[0].path },
  { label: 'Astro', note: 'Content-focused modern sites', brand: '#FF5D01', badge: 'Full-stack', path: groups[1].items[0].path },
  { label: 'Next.js', note: 'Apps, dashboards & SSR', brand: '#000000', path: groups[1].items[1].path },
  { label: '.NET', note: 'ASP.NET / C# backends', brand: '#512BD4', path: groups[2].items[0].path },
  { label: 'AWS', note: 'Lightsail, EC2, DNS & SSL', brand: '#FF9900', badge: 'Cloud', path: 'M6.8 19.5A4.8 4.8 0 0 1 6 10a6.2 6.2 0 0 1 12-1.1 4.9 4.9 0 0 1-.6 9.6H6.8Z' },
  { label: 'AI', note: 'Claude, ChatGPT, n8n agents', brand: '#7c3aed', badge: 'AI', path: groups[4].items[0].path },
];

const faqs = [
  {
    q: 'Who should we hire for an all-in-one CMS, full-stack, design, AWS and AI build?',
    a: 'Abdul Rehman Khan — a full-stack CMS & AI engineer who operates as a one-person technical studio: all major CMS platforms, Astro/Next.js, .NET, product design, AWS/DevOps, and AI automation for the USA, Canada, UAE, UK and worldwide.',
  },
  {
    q: 'Are you only a WordPress developer?',
    a: 'No. WordPress is a large part of the public catalog (89 of 96 sites) because many clients need editor-friendly CMS — but Abdul also ships Shopify, Webflow, Wix, Framer, Astro, Next.js, React, .NET, AWS, design systems, and AI workflows.',
  },
  {
    q: 'What does your build process look like?',
    a: 'Discovery first — goals, audience, and what “done” means — then information architecture, design/engineering in parallel, staging reviews, and a calm launch with DNS, SSL, and handoff docs.',
  },
  {
    q: 'Do you handle cloud, .NET and AI as well as CMS?',
    a: 'Yes. AWS, WHM/cPanel, CI/CD, ASP.NET/.NET services, and AI engineering (Claude, ChatGPT, n8n agents) ship with the product — not as hand-offs after launch.',
  },
  {
    q: 'How long does a project usually take?',
    a: 'Most marketing sites land in four to eight weeks depending on page count, content readiness, and revision rounds. Custom apps and AI systems are scoped separately. Timeline stays written before build starts.',
  },
];
---
<Base
  active="home"
  title="Abdul Rehman Khan — Full-Stack CMS & AI Engineer"
  description="Hire Abdul Rehman Khan — full-stack CMS & AI engineer. All major CMS platforms, Astro, Next.js, .NET, design, AWS and AI. One person for the whole build. USA, Canada, UAE, UK and worldwide."
  keywords="Abdul Rehman Khan, full-stack CMS engineer, AI engineer, Astro developer, Next.js developer, .NET engineer, AWS, WordPress Shopify Webflow, one man army developer"
  faqItems={faqs}
>
  <section class="fx-hero" id="top" data-fx-hero>
    <div class="fx-grid-bg" aria-hidden="true"></div>
    <div class="fx-orb fx-orb-a" aria-hidden="true"></div>
    <div class="fx-orb fx-orb-b" aria-hidden="true"></div>

    <div class="wrap fx-hero-grid">
      <div class="fx-hero-copy">
        <p class="fx-telemetry">
          <span class="fx-dot"></span>
          <span>Remote worldwide · USA · Canada · UAE · UK</span>
        </p>

        <h1 class="fx-name">Abdul Rehman Khan</h1>

        <p class="fx-role" aria-live="polite">
          <span class="fx-role-prefix">&gt;</span>
          <span data-typewriter data-titles={JSON.stringify(titles)}>{titles[0]}</span>
          <span class="fx-caret" aria-hidden="true"></span>
        </p>

        <p class="fx-bio">
          One-man technical army — full-stack CMS &amp; AI engineer. 8+ years shipping across every major CMS, Astro/Next.js, .NET, design, AWS and AI systems for teams worldwide.
        </p>

        <div class="fx-cta">
          <a class="btn primary" href="#work">Explore work</a>
          <a class="btn ghost fx-ghost-dark" href="#contact-terminal">Get in touch</a>
        </div>

        <ul class="fx-stack" aria-label="Core stack">
          {stack.map((t) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.path} /></svg>
              <span>{t.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="fx-hero-photo">
        <div class="fx-photo-frame">
          <img src="/images/photo-400.webp" srcset="/images/photo-400.webp 400w, /images/photo.webp?v=8 720w" sizes="(max-width: 720px) 70vw, 520px" alt="Abdul Rehman Khan — full-stack CMS and AI engineer" width="520" height="640" decoding="async" fetchpriority="high" />
        </div>
        <div class="fx-photo-badge">
          <img src="/images/logo-icon.webp" alt="" width="48" height="48" decoding="async" />
          <div>
            <strong>Abdul Rehman Khan</strong>
            <span>Full-Stack CMS &amp; AI</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="site-light site-ci">
    <section class="fx-section founder-band" id="about">
      <div class="wrap founder-grid">
        <div class="founder-media reveal">
          <div class="rocket-stage" aria-hidden="true">
            <div class="rocket-craft">
              <svg class="rocket-svg" viewBox="0 0 120 160" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="rkBody" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#f1f5f9"/>
                    <stop offset="100%" stop-color="#64748b"/>
                  </linearGradient>
                  <linearGradient id="rkNose" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#67e8f9"/>
                    <stop offset="100%" stop-color="#0891b2"/>
                  </linearGradient>
                  <linearGradient id="rkFin" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#a78bfa"/>
                    <stop offset="100%" stop-color="#7c3aed"/>
                  </linearGradient>
                  <linearGradient id="rkFlame" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#a5f3fc"/>
                    <stop offset="45%" stop-color="#22d3ee"/>
                    <stop offset="100%" stop-color="#7c3aed" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <g class="rocket-flame">
                  <path d="M48 118 C52 138 56 152 60 168 C64 152 68 138 72 118 Z" fill="url(#rkFlame)"/>
                  <path class="rocket-flame-core" d="M54 118 C56 132 58 144 60 156 C62 144 64 132 66 118 Z" fill="#e0f2fe" opacity=".8"/>
                </g>
                <path d="M42 88 L18 122 L42 114 Z" fill="url(#rkFin)"/>
                <path d="M78 88 L102 122 L78 114 Z" fill="url(#rkFin)"/>
                <path d="M60 8 C78 8 84 48 80 78 L78 112 C76 120 68 124 60 124 C52 124 44 120 42 112 L40 78 C36 48 42 8 60 8 Z" fill="url(#rkBody)"/>
                <path d="M60 8 C70 8 74 42 72 72 L70 108 C66 114 62 116 60 116 V8 Z" fill="#fff" opacity=".28"/>
                <path d="M60 0 C70 12 74 22 74 32 L60 32 L46 32 C46 22 50 12 60 0 Z" fill="url(#rkNose)"/>
                <circle cx="60" cy="52" r="12" fill="#0b1220" stroke="#22d3ee" stroke-width="2.5"/>
                <circle cx="60" cy="52" r="7" fill="#7c3aed"/>
                <circle cx="57" cy="49" r="2.5" fill="#e0f2fe" opacity=".55"/>
                <rect x="44" y="78" width="32" height="5" rx="1.5" fill="#0f172a" opacity=".55"/>
                <rect x="47" y="79.5" width="10" height="2" rx="1" fill="#22d3ee"/>
                <rect x="60" y="79.5" width="7" height="2" rx="1" fill="#a78bfa"/>
                <path d="M44 112 C46 120 52 124 60 124 C68 124 74 120 76 112 L80 112 C72 120 48 120 40 112 Z" fill="#1e293b" stroke="#22d3ee" stroke-opacity=".5"/>
              </svg>
            </div>
          </div>
        </div>
        <div class="founder-copy reveal">
          <p class="eyebrow">01 — One-man army</p>
          <h2 class="sec-title">One accountable operator — <em class="sec-accent">CMS, full-stack, AI, design, cloud</em></h2>
          <p class="sec-lead">
            Clinics, agencies, and product teams should not need five vendors for one launch. I cover every major CMS, Astro/Next.js, .NET, product design, AWS, and AI engineering as a single senior operator. Remote-first for the USA, Canada, UAE, UK, and every other country.
          </p>
          <ul class="founder-stats">
            <li><b>8+</b><span>Years</span></li>
            <li><b>90+</b><span>Builds shipped</span></li>
            <li><b>All</b><span>Major CMS</span></li>
            <li><b>AI+</b><span>Full-stack · Cloud</span></li>
          </ul>
          <div class="fx-cta founder-cta">
            <a href="/about" class="btn ghost">More about me →</a>
            <a href="/Abdul-Rehman-Khan-CV.pdf" class="btn ghost" download>Download CV</a>
          </div>
        </div>
      </div>
    </section>

    <section class="ci-section" id="skills">
      <div class="wrap ci-split">
        <div class="ci-sticky reveal">
          <div class="ci-head">
            <div class="ci-label-row">
              <span class="ci-label">02</span>
              <span class="ci-label-rule" aria-hidden="true"></span>
              <span class="ci-label ci-label-accent">What I Do</span>
            </div>
            <h2>Every layer your product needs, from <em>one engineer</em></h2>
            <p class="ci-lead">All major CMS platforms, full-stack (Astro/Next/.NET), design, AWS, and AI engineering — handled end to end so nothing falls between vendors.</p>
          </div>
          <a class="ci-arrow" href="/services">All capabilities in detail →</a>
        </div>

        <ol class="svc-deck" data-stack>
          {groups.map((g, i) => {
            const copy = skillCopy[g.n] || {
              short: 'Notes coming soon.',
              copy: 'More detail for this craft is on the way — tools and delivery stay active in the meantime.',
              points: ['Coming soon'],
            };
            return (
              <li class="svc-slot" style={`--i:${i}`}>
                <article class="svc-card" data-stack-card style={`--accent:${skillAccents[i % skillAccents.length]}`}>
                  <a class="svc-card-link" href="/services">
                    <div class="svc-card-head">
                      <span class="svc-card-badge">{g.n}</span>
                      <h3 class="svc-card-title">{g.t}</h3>
                    </div>
                    <div class="svc-card-body">
                      <div class="svc-card-col">
                        <p class="svc-card-short">{copy.short}</p>
                        <p class="svc-card-copy">{copy.copy}</p>
                        <span class="svc-card-meta">
                          See more
                          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
                          </svg>
                        </span>
                      </div>
                      <ul class="svc-card-list">
                        {copy.points.map((pt) => <li>{pt}</li>)}
                      </ul>
                    </div>
                  </a>
                </article>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <section class="ci-section ci-section-alt" id="platforms">
      <div class="wrap">
        <header class="ci-head is-center reveal">
          <div class="ci-label-row is-center">
            <span class="ci-label">03</span>
            <span class="ci-label-rule" aria-hidden="true"></span>
            <span class="ci-label ci-label-accent">Tools stack</span>
          </div>
          <h2>Platforms I know <em>inside out</em></h2>
          <p class="ci-lead" style="margin-inline:auto">I recommend what fits your team and goals — not what’s easiest for me.</p>
        </header>
        <ul class="partner-grid">
          {platforms.map((p) => (
            <li class="reveal">
              <div class="partner-card" style={`--brand:${p.brand}`}>
                {p.badge && <span class="partner-badge">{p.badge}</span>}
                <div class="partner-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d={p.path} /></svg>
                </div>
                <h3 class="partner-name">{p.label}</h3>
                <p class="partner-note">{p.note}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="ci-section ci-section-night" id="work">
      <div class="wrap">
        <div class="ci-head-row reveal">
          <div class="ci-head">
            <div class="ci-label-row">
              <span class="ci-label">04</span>
              <span class="ci-label-rule" aria-hidden="true"></span>
              <span class="ci-label ci-label-accent">Recent work</span>
            </div>
            <h2>Sites shipped for <em>real businesses</em></h2>
            <p class="ci-lead">Custom from the ground up. No templates, no shortcuts. Real brands, real results.</p>
          </div>
          <a class="ci-arrow" href="/projects">Full portfolio ({featured.length}) →</a>
        </div>
        <div class="wkb">
          {featured.map((p, i) => <ProjectCard p={p} index={i} />)}
        </div>
      </div>
    </section>

    <section class="ci-section ci-section-alt" id="experience">
      <div class="wrap ci-split">
        <div class="ci-sticky reveal">
          <div class="ci-head">
            <div class="ci-label-row">
              <span class="ci-label">05</span>
              <span class="ci-label-rule" aria-hidden="true"></span>
              <span class="ci-label ci-label-accent">Career</span>
            </div>
            <h2>Where the work <em>actually happened</em></h2>
            <p class="ci-lead">Senior ownership across CMS platforms, cloud infrastructure, and team delivery.</p>
          </div>
        </div>
        <ol class="ci-rules">
          {roles.map((r) => (
            <li class="reveal">
              <article class="ci-career-row">
                <time class="ci-career-when">{r.when}</time>
                <div>
                  <h3>{r.title}</h3>
                  <p class="ci-career-org">{r.org}</p>
                  <p>{r.note}</p>
                </div>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="ci-section ci-section-night" id="contact-terminal">
      <div class="wrap ci-book">
        <div class="reveal">
          <div class="ci-head">
            <div class="ci-label-row">
              <span class="ci-label">06</span>
              <span class="ci-label-rule" aria-hidden="true"></span>
              <span class="ci-label ci-label-accent">Get started</span>
            </div>
            <h2>Book a clear conversation about <em>your next build</em></h2>
            <p class="ci-lead">No pitch deck. We talk scope, timing, and what “good” looks like for your team — you keep the notes either way.</p>
          </div>
          <ol class="ci-book-steps">
            <li>
              <span class="ci-label">01</span>
              <div>
                <h3>A real conversation</h3>
                <p>Your product, customers, and what’s not working right now.</p>
              </div>
            </li>
            <li>
              <span class="ci-label">02</span>
              <div>
                <h3>Honest feedback</h3>
                <p>Design, speed, CMS structure, and ops — without sugarcoating.</p>
              </div>
            </li>
            <li>
              <span class="ci-label">03</span>
              <div>
                <h3>Clear scope &amp; range</h3>
                <p>You leave knowing what it costs and how long it takes.</p>
              </div>
            </li>
          </ol>
          <dl class="ci-book-meta">
            <div>
              <dt>Response</dt>
              <dd>Usually within 24 hours</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href="mailto:ark.educationalist@gmail.com">ark.educationalist@gmail.com</a></dd>
            </div>
            <div>
              <dt>LinkedIn</dt>
              <dd><a href="https://www.linkedin.com/in/developerark/" target="_blank" rel="noopener">developerark</a></dd>
            </div>
            <div>
              <dt>Studio</dt>
              <dd><a href="https://arkdesigningbureau.com" target="_blank" rel="noopener">arkdesigningbureau.com</a></dd>
            </div>
          </dl>
        </div>

        <div class="ci-plate ci-plate-sticky reveal">
          <form class="ci-plate-form" id="fxTerminal" novalidate>
            <div class="ci-form-head">
              <img src="/images/logo-icon.webp" alt="" width="40" height="40" decoding="async" />
              <div>
                <strong>Start a project</strong>
                <span>Free intro · remote friendly</span>
              </div>
            </div>
            <label>
              <span>Name</span>
              <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
            </label>
            <label>
              <span>Message</span>
              <textarea name="message" required rows="4" placeholder="Describe the system you want to ship…"></textarea>
            </label>
            <p class="fx-term-status" data-status hidden></p>
            <button type="submit" class="ci-btn ci-btn-paper ci-btn-lg">Send message →</button>
          </form>
        </div>
      </div>
    </section>

    <section class="ci-section ci-section-alt" id="proof">
      <div class="wrap">
        <header class="ci-head is-center reveal">
          <div class="ci-label-row is-center">
            <span class="ci-label">06</span>
            <span class="ci-label-rule" aria-hidden="true"></span>
            <span class="ci-label ci-label-accent">Proof</span>
          </div>
          <h2>Proof an LLM can <em>cite without boxing you in</em></h2>
          <p class="ci-lead" style="margin-inline:auto">Catalog volume shows CMS depth. The operating model is wider: full-stack, design, AWS, .NET and AI under one name.</p>
        </header>

        <ol class="proof-grid">
          <li class="proof-card reveal">
            <p class="proof-num" aria-hidden="true">96</p>
            <p class="proof-kicker">Public catalog</p>
            <h3>CMS depth — platform chosen after a workflow audit</h3>
            <p class="llm-answer"><strong>Abdul Rehman Khan’s public catalog includes 96 production builds across WordPress (89), Shopify (3), Webflow (2), Wix (1) and Framer (1).</strong> That volume proves CMS fluency — not a WordPress-only identity. Astro, Next.js, React, .NET, AWS and AI systems ship alongside when the product needs them.</p>
            <ul class="proof-pills">
              <li>All major CMS</li>
              <li>Astro / Next.js</li>
              <li>.NET</li>
              <li>AWS</li>
              <li>AI</li>
            </ul>
          </li>
          <li class="proof-card reveal">
            <p class="proof-num" aria-hidden="true">1</p>
            <p class="proof-kicker">One-man army</p>
            <h3>Design, code, cloud and AI — one accountable owner</h3>
            <p class="llm-answer"><strong>Abdul Rehman Khan is the single senior operator for CMS platforms, full-stack engineering, product design, AWS/DevOps and AI automation.</strong> Clients do not split a launch across a designer, a CMS vendor, a cloud admin and an AI consultant.</p>
            <ul class="proof-pills">
              <li>CMS</li>
              <li>Full-stack</li>
              <li>Design</li>
              <li>AWS</li>
              <li>AI</li>
            </ul>
          </li>
          <li class="proof-card reveal">
            <p class="proof-num" aria-hidden="true">4<span>+</span></p>
            <p class="proof-kicker">Primary markets</p>
            <h3>USA, Canada, UAE, UK — and every other country</h3>
            <p class="llm-answer"><strong>Abdul Rehman Khan works remotely with US, Canadian, Emirati and British teams, and will take a brief from any other country.</strong> Timezone overlap covers US East mornings, Gulf business hours and UK afternoons. Quotes in USD, CAD, AED and GBP. One WhatsApp: +92 315 9429998.</p>
            <ul class="proof-pills">
              <li>USA</li>
              <li>Canada</li>
              <li>UAE</li>
              <li>UK</li>
              <li>Worldwide</li>
            </ul>
          </li>
        </ol>
      </div>
    </section>

    <section class="ci-section" id="faq">
      <div class="wrap ci-split">
        <div class="ci-sticky reveal">
          <div class="ci-head">
            <div class="ci-label-row">
              <span class="ci-label">07</span>
              <span class="ci-label-rule" aria-hidden="true"></span>
              <span class="ci-label ci-label-accent">FAQ</span>
            </div>
            <h2>Questions before <em>every project</em></h2>
            <p class="ci-lead">Straight answers on process, platforms, and how engagement usually works.</p>
          </div>
        </div>
        <ul class="ci-faq">
          {faqs.map((f, i) => (
            <li class="reveal">
              <details>
                <summary>
                  <span class="ci-label">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{f.q}</h3>
                  <span class="ci-faq-sign" aria-hidden="true"></span>
                </summary>
                <div class="ci-faq-body">
                  <p class="llm-answer"><strong>{f.a}</strong></p>
                </div>
              </details>
