---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import IconChip from '../components/IconChip.astro';
import Pricing from '../components/Pricing.astro';
import projects from '../data/projects.json';
import { groups, allTech } from '../data/tech.mjs';

const filenameLike = (title) => /\.(com|ai|pk|ca|io)|wordpress|shopify|shopfiy|webflow|framer|wix/i.test(title);
const clean = projects.filter((p) => p.img && p.title && !filenameLike(p.title) && p.live);
const pool = clean.length >= 8 ? clean : projects.filter((p) => p.img);
const featured = pool.slice(0, 6);
const reel = [...pool.slice(0, 8), ...pool.slice(0, 8)];
const marquee = allTech.concat(allTech);
const roles = [
  { when: '2026 — now', title: 'Senior CMS Developer', org: 'Chameleon Ideas', note: 'Production WordPress, WooCommerce, hosting and release' },
  { when: '2024 — 2026', title: 'Senior Software Developer', org: 'Websity Digital', note: 'WordPress, WooCommerce, Webflow, Shopify, AWS Lightsail' },
  { when: '2022 — 2024', title: 'Senior CMS & Web Developer', org: 'Krystosoft', note: 'International CMS builds, migrations, mentoring' },
  { when: '2021 — 2022', title: 'Software Developer', org: 'Mystic Advertising', note: 'WordPress and Shopify storefronts' },
  { when: '2020 — 2021', title: 'Frontend Web Developer', org: 'Nisshinbo Holdings', note: 'ASP.NET MVC, responsive frontend' },
];
---
<Base active="home">
  <header class="hero">
    <div class="wrap">
      <div class="sheet-top">
        <p class="meta">ARK / 001 — Karachi, Pakistan</p>
        <p class="meta"><span class="pulse"></span> Open to remote roles and contracts</p>
      </div>
      <h1 class="reveal">Abdul Rehman <em>Khan</em></h1>
      <p class="lede reveal">Senior CMS developer. WordPress and WooCommerce first, then Shopify, Webflow, and the hosting that keeps them up.</p>
      <dl class="spec reveal">
        <div><dt>Core</dt><dd>WordPress · WooCommerce · Shopify</dd></div>
        <div><dt>Also ships</dt><dd>Webflow · Next.js · Astro · PHP</dd></div>
        <div><dt>Record</dt><dd>8+ years · 90+ production sites</dd></div>
      </dl>
      <div class="hero-cta reveal">
        <a href="/projects" class="btn primary">Selected work</a>
        <a href="/about" class="btn ghost">Experience</a>
        <a href="https://www.linkedin.com/in/developerark/" class="btn ghost">LinkedIn</a>
      </div>
    </div>
    <div class="reel" aria-label="Recent production sites">
      <div class="reel-track">
        {reel.map((p) => (
          <a href={p.live || '/projects'} target={p.live ? '_blank' : undefined} rel={p.live ? 'noopener' : undefined}>
            <img src={p.img} alt="" />
            <span>{p.title} · {p.platform}</span>
          </a>
        ))}
      </div>
    </div>
  </header>

  <div class="wrap"><div class="marquee reveal"><div class="track">
    {marquee.map((t) => <span class="techchip"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.path} /></svg><em>{t.label}</em></span>)}
  </div></div></div>

  <section>
    <div class="wrap about-blurb">
      <div class="reveal">
        <p class="eyebrow">About</p>
        <p class="big">I take a site from the design file to a live server: theme or storefront, custom fields, DNS, SSL, and the release. Most of the work is WordPress and WooCommerce for clinics, agencies, and shops in Pakistan, the UAE, and Canada.</p>
        <div class="hero-cta" style="margin-top:28px;"><a href="/about" class="btn ghost">More about me →</a></div>
      </div>
      <div class="stat-row reveal">
        <div class="stat"><div class="v"><b>8</b>+</div><div class="l">Years experience</div></div>
        <div class="stat"><div class="v"><b>90</b>+</div><div class="l">Projects shipped</div></div>
        <div class="stat"><div class="v"><b>7</b>+</div><div class="l">CMS platforms</div></div>
        <div class="stat"><div class="v"><b>1</b></div><div class="l">Person, whole build</div></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="reveal"><p class="eyebrow">Selected work</p><h2 class="sec-title">Six recent builds</h2></div>
        <a href="/projects" class="btn ghost reveal">View all projects →</a>
      </div>
      <div class="proj-grid">
        {featured.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="reveal" style="margin-bottom:44px;"><p class="eyebrow">Toolkit</p><h2 class="sec-title">Skills &amp; technologies</h2></div>
      <div class="skill-grid">
        {groups.map((g) => (
          <div class="skill-card reveal">
            <span class="num">{g.n}</span><h3>{g.t}</h3>
            <div class="tech-row">{g.items.map((t) => <IconChip label={t.label} path={t.path} />)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="reveal" style="margin-bottom:28px;"><p class="eyebrow">Employment</p><h2 class="sec-title">Where the work happened</h2></div>
      <div class="role-list reveal">
        {roles.map((r) => (
          <article class="role">
            <time>{r.when}</time>
            <div><strong>{r.title}</strong><span>{r.note}</span></div>
            <em>{r.org}</em>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="reveal"><p class="eyebrow">Pricing</p><h2 class="sec-title">Simple, transparent packages</h2>
        <p class="sec-lead">Fixed-scope packages to start, or a custom quote for bigger builds. Prices in PKR — use the calculator for your currency.</p></div>
        <a href="/pricing" class="btn ghost reveal">Compare packages →</a>
      </div>
      <div class="reveal"><Pricing compact={true} /></div>
      <div class="reveal" style="text-align:center;margin-top:26px;"><a href="/estimate" class="btn ghost">Build a live estimate →</a></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="cta-band reveal"><div class="glow"></div>
        <h2>Have a project in mind?</h2>
        <p>CMS or custom, e-commerce, design, automation or hosting — one person, from first idea to a live, production site.</p>
        <div class="hero-cta"><a href="/estimate" class="btn primary">Get an instant estimate</a><a href="/contact" class="btn ghost">Get in touch</a></div>
      </div>
    </div>
  </section>
</Base>
